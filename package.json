{
  "name": "luggage-finder",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "test": "node --test \"src/**/__tests__/*.test.mjs\"",
    "test:watch": "node --test --watch \"src/**/__tests__/*.test.mjs\"",
    "build:mockups": "node scripts/build-mockups.mjs",
    "build:bags": "node data/build-bags.mjs",
    "validate": "node data/validate.mjs",
    "verify:pages": "node scripts/verify-pages.mjs",
    "verify:engine": "node scripts/verify-mockup-engine.mjs",
    "verify:inlined": "node scripts/build-mockups.mjs --check",
    "coverage": "node data/coverage.mjs",
    "audit": "node data/fixture-audit.mjs",
    "verdicts": "node data/verdicts.mjs",
    "drift": "node docs/check-drift.mjs",
    "check": "npm run lint && npm run test && npm run verify:pages && npm run verify:spacing && npm run verify:engine && npm run build:bags && npm run validate && npm run validate:carriers && npm run drift && npm run build && npm run verify:build",
    "validate:carriers": "node data/validate-carriers.mjs",
    "publish:check": "node data/validate-carriers.mjs --publish",
    "dev": "astro dev",
    "build": "node scripts/build-client-data.mjs && astro build",
    "preview": "astro preview",
    "verify:build": "node scripts/verify-build.mjs",
    "lint": "biome check",
    "lint:fix": "biome check --write",
    "format": "biome format --write",
    "verify:spacing": "node scripts/verify-spacing.mjs",
    "build:client-data": "node scripts/build-client-data.mjs"
  },
  "dependencies": {
    "@astrojs/cloudflare": "^14.2.5",
    "@astrojs/internal-helpers": "^0.10.4",
    "@astrojs/preact": "^6.0.4",
    "@tailwindcss/vite": "^4.3.3",
    "astro": "^7.2.9",
    "downshift": "^9.4.0",
    "preact": "^10.29.8",
    "tailwindcss": "^4.3.3",
    "three": "^0.185.1"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.11"
  },
  "packageManager": "pnpm@10.20.0"
}
