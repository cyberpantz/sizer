---
/* Filter pills, plus the Filters popover.
 *
 * Matching the approved mockup: a "Show" label, pill-shaped buttons, a solid
 * blue selected state with a ring, and a blue-wash panel underneath carrying a
 * note about the shape you just picked. The pills and their editorial live in
 * lib/bag-shapes.mjs; the reason they are a module rather than literals in this
 * file is written down there, and it is not tidiness.
 *
 * TWO CONTROLS, ONE STATE. The shape pills stay visible because they carry the
 * editorial notes and they are the axis people actually browse by. Everything
 * else lives behind the Filters button (BagFacetPanel). Both feed one apply(),
 * because two filtering code paths over one grid is how you get a card that is
 * hidden by one control and shown by the other.
 *
 * Progressive enhancement — every bag is already in the HTML. Without
 * JavaScript nothing is hidden and no filter lies about what is on the page.
 */
import BagFacetPanel from './BagFacetPanel.astro';
import { GROUPS, NOTES } from '../lib/bag-shapes.mjs';

/* Re-exported so /bags can count each pill's stock from one definition. */
export { GROUPS };

const { counts, optionCounts, total, brands } = Astro.props;

const groups = GROUPS.filter((g) => (counts[g.id] ?? 0) > 0);
---
<div data-filters data-total={total} class="border-y border-rule py-4">
  <div class="flex flex-wrap items-center gap-2">
    <div class="flex flex-wrap items-center gap-2" role="group" aria-label="Filter by bag type">
      <span class="mr-1 text-[0.9375rem] text-muted">Show</span>

      <button
        type="button"
        data-filter="all"
        aria-pressed="true"
        class="cursor-pointer rounded-full border-2 px-5 py-2 text-[0.9375rem] font-medium
               border-rule-strong bg-surface text-ink hover:border-blue
               aria-pressed:border-blue aria-pressed:bg-blue aria-pressed:text-on-blue"
      >Everything</button>

      {groups.map((g) => (
        <button
          type="button"
          data-filter={g.id}
          aria-pressed="false"
          class="cursor-pointer rounded-full border-2 px-5 py-2 text-[0.9375rem] font-medium
                 border-rule-strong bg-surface text-ink hover:border-blue
                 aria-pressed:border-blue aria-pressed:bg-blue aria-pressed:text-on-blue"
        >{g.label}</button>
      ))}
    </div>

    <div class="ml-auto"><BagFacetPanel optionCounts={optionCounts} total={total} brands={brands} /></div>
  </div>

  {/* Active facets, in the open. The panel closes over its own state, so
      without this a filtered page is indistinguishable from an empty one. */}
  <div data-facet-chips hidden class="mt-3 flex flex-wrap items-center gap-2"></div>

  {/* What the filters actually did, announced. Shelf counts update, but a
      reader who has just hidden two thirds of the page deserves the total —
      and a screen-reader user gets nothing at all from cards silently
      disappearing. aria-live is on the count, not the grid, so it reads one
      short sentence instead of every card that moved. */}
  <p data-filter-count hidden aria-live="polite" class="mt-3 text-[0.875rem] text-muted"></p>

  <div data-filter-note hidden class="mt-4 rounded-card bg-blue-wash p-5 text-[0.9375rem] leading-relaxed text-ink-2">
    <strong class="font-semibold text-ink" data-note-lead></strong>{' '}
    <span data-note-body></span>
  </div>
</div>

<script>
  /* A BUNDLED MODULE SCRIPT, NOT define:vars — see lib/bag-shapes.mjs.

     define:vars makes a script inline, and an inline script cannot import, so
     every value had to be serialised through that attribute and every FUNCTION
     had to be written out again inside here. That is how the facet matching
     rule ended up duplicated beside the counting rule it has to agree with.

     The one runtime value this needs — the catalogue total — comes off a data
     attribute instead, which is the other way data legitimately reaches a
     bundled script. */
  import { matchesFacets } from '../lib/bag-facets.mjs';
  import { NOTES, typesFor } from '../lib/bag-shapes.mjs';

  const root = document.querySelector('[data-filters]');
  const total = Number(root.dataset.total);
  const panel = root.querySelector('[data-filter-note]');
  const lead = root.querySelector('[data-note-lead]');
  const body = root.querySelector('[data-note-body]');
  const pills = [...root.querySelectorAll('[data-filter]')];

  const facetRoot = root.querySelector('[data-facets]');
  const toggle = facetRoot?.querySelector('[data-facet-toggle]');
  const facetPanel = facetRoot?.querySelector('[data-facet-panel]');
  const badge = facetRoot?.querySelector('[data-facet-count]');
  const boxes = [...(facetRoot?.querySelectorAll('[data-facet]') ?? [])];
  const chips = root.querySelector('[data-facet-chips]');
  const count = root.querySelector('[data-filter-count]');

  let shape = 'all';

  const checked = () => boxes.filter((b) => b.checked);

  /* Selected values grouped by axis. Within an axis the test is OR (budget
     OR midrange); across axes it is AND (budget AND softside).
     That is what every faceted search does, and getting it backwards makes
     every additional tick return fewer results until nothing is left. */
  function selection() {
    const sel = {};
    for (const b of checked()) (sel[b.dataset.facet] ??= new Set()).add(b.value);
    return sel;
  }

  /* THE MATCHING RULE IS IMPORTED, NOT RESTATED.

     An option can stand for several stamped values — the weight options are
     cumulative, so "under 3.5 kg" also matches a bag under 2.5 kg — and within
     an axis the test is OR while across axes it is AND. All of that used to
     live here, inline, where no test could reach it. The panel counted with
     FACET_MATCH and this matched with a hand-rolled loop beside it, which is
     precisely how a count starts describing a different set of bags than the
     filter returns.

     Brand is the axis that forced the issue: an error here would be invisible,
     because nobody knows off-hand how many Travelpros we hold. On weight you
     would notice. */
  const AXIS_KEY = {
    weight: 'bagWeight',
    shell: 'bagShell',
    price: 'bagPrice',
    role: 'bagRole',
    brand: 'bagBrand',
  };

  function matches(card, sel) {
    if (shape !== 'all' && !typesFor(shape).includes(card.dataset.bagType)) return false;
    const values = Object.fromEntries(
      Object.keys(AXIS_KEY).map((axis) => [axis, card.dataset[AXIS_KEY[axis]] ?? ''])
    );
    return matchesFacets(values, sel);
  }

  function apply() {
    for (const p of pills) p.setAttribute('aria-pressed', String(p.dataset.filter === shape));

    const note = NOTES[shape];
    panel.hidden = !note;
    if (note) {
      lead.textContent = note.lead;
      body.textContent = note.body;
    }

    const sel = selection();
    for (const card of document.querySelectorAll('[data-bag-type]')) {
      card.hidden = !matches(card, sel);
    }

    /* A shelf whose bags are all filtered out leaves an empty heading with a
       count that contradicts the screen. Hide it and recount. */
    for (const section of document.querySelectorAll('[data-shelf]')) {
      const shown = [...section.querySelectorAll('[data-bag-type]')].filter((c) => !c.hidden).length;
      section.hidden = shown === 0;
      const count = section.querySelector('[data-shelf-count]');
      if (count) count.textContent = `${shown} ${shown === 1 ? 'bag' : 'bags'}`;
    }

    /* Every shelf empty means the filter found nothing — say so rather than
       leaving the reader looking at a blank page below the pills. */
    const any = [...document.querySelectorAll('[data-shelf]')].some((s) => !s.hidden);
    const empty = document.querySelector('[data-empty]');
    if (empty) empty.hidden = any;

    /* A bag can sit on more than one shelf, so counting visible cards would
       double-count. Count distinct slugs. */
    const shown = new Set(
      [...document.querySelectorAll('[data-bag-type]')]
        .filter((c) => !c.hidden)
        .map((c) => c.dataset.bagSlug)
    ).size;

    if (count) {
      const filtered = shape !== 'all' || checked().length > 0;
      count.hidden = !filtered;
      count.textContent = filtered
        ? shown === total
          ? `All ${total} bags match.`
          : `Showing ${shown} of ${total} bags.`
        : '';
    }

    renderChips();
  }

  /* Active facets rendered as removable chips. textContent, never innerHTML —
     these strings come from the DOM and building markup out of them is how a
     label turns into an injection. */
  function renderChips() {
    if (!chips) return;
    chips.textContent = '';
    const on = checked();

    if (badge) {
      badge.hidden = on.length === 0;
      badge.textContent = String(on.length);
    }
    chips.hidden = on.length === 0;
    if (!on.length) return;

    for (const b of on) {
      const chip = document.createElement('button');
      chip.type = 'button';
      chip.className =
        'flex cursor-pointer items-center gap-1.5 rounded-full border border-blue bg-blue-wash ' +
        'px-3 py-1 text-[0.875rem] text-blue hover:bg-surface-2';
      const label = b.closest('label')?.querySelector('span > span')?.textContent ?? b.value;
      chip.textContent = label;
      chip.setAttribute('aria-label', `Remove filter: ${label}`);

      const x = document.createElement('span');
      x.textContent = '×';
      x.setAttribute('aria-hidden', 'true');
      x.className = 'text-[1.125rem] leading-none';
      chip.append(x);

      chip.addEventListener('click', () => {
        b.checked = false;
        apply();
        toggle?.focus();
      });
      chips.append(chip);
    }
  }

  /* ---------- searching a long facet ---------- */

  /* Filters the LABELS on screen. It does not touch the checkboxes, which is
     the whole design: a brand ticked and then typed out of view stays ticked,
     stays counted in the badge, and stays visible as a chip in the open. That
     is the panel's existing rule — a filter you cannot see is a filter you
     forget you set — and a search box is the easiest way to break it, because
     hiding a control looks like clearing it.

     Matched on `includes`, not `startsWith`. Someone hunting for Briggs &
     Riley may well type "riley", and a prefix match would tell them we do not
     stock it. */
  for (const input of root.querySelectorAll('[data-facet-search]')) {
    const axis = input.dataset.facetSearch;
    const section = root.querySelector(`[data-facet-section="${axis}"]`);
    const empty = root.querySelector(`[data-facet-empty="${axis}"]`);
    input.addEventListener('input', () => {
      const q = input.value.trim().toLowerCase();
      let shown = 0;
      for (const label of section.querySelectorAll('[data-facet-option]')) {
        const hit = !q || label.textContent.toLowerCase().includes(q);
        label.hidden = !hit;
        if (hit) shown += 1;
      }
      if (empty) empty.hidden = shown > 0;
    });
  }

  /* ---------- the popover ---------- */

  /* EDGE DETECTION. The panel is anchored to the button's right edge, which is
     correct while the button sits at the right of the filter row — but the
     shape pills wrap at narrow widths and the button moves, so no static
     anchor holds at every size. Anchored left it ran clean off the screen.

     Measure after showing, then translate by however much it overhangs. Reset
     first, or a second open compounds the previous nudge. */
  const GUTTER = 12;
  function position() {
    if (!facetPanel) return;
    facetPanel.style.transform = '';
    const r = facetPanel.getBoundingClientRect();
    const overRight = r.right - (window.innerWidth - GUTTER);
    const overLeft = GUTTER - r.left;
    /* Right first, then left — if the panel is wider than the viewport the
       left edge wins, because losing the end of a line is recoverable and
       losing the checkboxes is not. */
    const shift = overRight > 0 ? -overRight : overLeft > 0 ? overLeft : 0;
    if (shift) facetPanel.style.transform = `translateX(${Math.round(shift)}px)`;
  }

  function openPanel(open) {
    if (!toggle || !facetPanel) return;
    facetPanel.hidden = !open;
    toggle.setAttribute('aria-expanded', String(open));
    if (open) position();
  }

  if (toggle && facetPanel) {
    toggle.addEventListener('click', () =>
      openPanel(toggle.getAttribute('aria-expanded') !== 'true')
    );

    for (const b of boxes) b.addEventListener('change', apply);

    facetRoot.querySelector('[data-facet-done]')?.addEventListener('click', () => {
      openPanel(false);
      toggle.focus();
    });

    facetRoot.querySelector('[data-facet-clear]')?.addEventListener('click', clearAll);

    /* Escape closes and RETURNS FOCUS to the button. Without the second half a
       keyboard user is dumped at the top of the document and has to tab back
       through the whole page to where they were. */
    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape' && toggle.getAttribute('aria-expanded') === 'true') {
        openPanel(false);
        toggle.focus();
      }
    });

    /* Click outside closes. Not focusout: a click on a label inside the panel
       moves focus in a way that closes the panel mid-interaction. */
    document.addEventListener('pointerdown', (e) => {
      if (!facetRoot.contains(e.target)) openPanel(false);
    });

    /* Re-measure while open. A resize or a scroll-driven layout shift moves
       the button, and a panel positioned once is only correct once. */
    for (const ev of ['resize', 'orientationchange']) {
      window.addEventListener(ev, () => {
        if (toggle.getAttribute('aria-expanded') === 'true') position();
      });
    }
  }

  for (const p of pills)
    p.addEventListener('click', () => {
      shape = p.dataset.filter;
      apply();
    });

  /* Resets EVERY control, shape pill included. The empty state is reached by
     any combination, so a "clear" that only cleared the popover would leave a
     reader still staring at nothing, having done what the page told them. */
  function clearAll() {
    for (const b of boxes) b.checked = false;
    /* The search box is a VIEW of the option list, not a filter on the
       catalogue, so "Clear all" has to reset it too — otherwise a reader who
       typed "tum", cleared everything, and reopened the panel finds one brand
       listed and 31 apparently gone. Reset by dispatching the same event a
       keystroke would, so the show/hide logic lives in exactly one place. */
    for (const input of root.querySelectorAll('[data-facet-search]')) {
      input.value = '';
      input.dispatchEvent(new Event('input'));
    }
    shape = 'all';
    apply();
  }

  document.querySelector('[data-clear-all]')?.addEventListener('click', () => {
    clearAll();
    toggle?.focus();
  });

  apply();
</script>
