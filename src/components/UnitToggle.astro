---
/* Units toggle. Always visible, every page.

   SSR renders the metric default and marks itself unresolved; the client
   corrects on load. Node's built-in navigator reports en-US, so asking the
   server would open every page in inches for every reader on earth
   (src/ui/units.mjs).

   The unresolved state is styled differently on purpose — until we know the
   reader's locale we must not imply a choice was made. */
---
<div
  data-units-toggle
  data-resolved="false"
  class="inline-flex overflow-hidden rounded-chip border border-rule-strong group"
>
  {/* "Metric" and "Imperial", not "cm" and "in".
      The control switches LENGTH AND WEIGHT — centimetres to inches and
      kilograms to pounds — so labelling it with a length unit described half
      of what it does. A reader who wants pounds had no reason to think this
      button was for them. */}
  <button type="button" data-unit="cm" aria-pressed="true" aria-label="Show metric units, centimetres and kilograms"
    class="text-[0.8125rem] leading-none px-3 py-2 bg-surface text-muted cursor-pointer border-0
           hover:bg-surface-2 hover:text-ink
           aria-pressed:bg-blue aria-pressed:text-on-blue aria-pressed:hover:bg-blue-hover
           aria-pressed:hover:text-on-blue
           group-data-[resolved=false]:aria-pressed:bg-surface-2
           group-data-[resolved=false]:aria-pressed:text-ink-2">Metric</button>
  <button type="button" data-unit="in" aria-pressed="false" aria-label="Show imperial units, inches and pounds"
    class="text-[0.8125rem] leading-none px-3 py-2 bg-surface text-muted cursor-pointer border-0
           hover:bg-surface-2 hover:text-ink
           aria-pressed:bg-blue aria-pressed:text-on-blue aria-pressed:hover:bg-blue-hover
           aria-pressed:hover:text-on-blue
           group-data-[resolved=false]:aria-pressed:bg-surface-2
           group-data-[resolved=false]:aria-pressed:text-ink-2">Imperial</button>
</div>

<script>
  import { createUnits } from '../ui/units.mjs';

  const U = createUnits();
  const root = document.querySelector('[data-units-toggle]');

  function paint() {
    for (const b of root.querySelectorAll('button')) {
      b.setAttribute('aria-pressed', String(b.dataset.unit === U.unit));
    }
    root.dataset.resolved = 'true';
    document.documentElement.dataset.units = U.unit;

    /* Every figure re-renders from cm. Elements opt in via data-cm / data-kg /
       data-dims so nothing has to be parsed back out of text a reader may
       already be looking at. */
    for (const el of document.querySelectorAll('[data-cm]')) {
      el.textContent = `${U.len(+el.dataset.cm)} ${U.lenLabel()}`;
    }
    for (const el of document.querySelectorAll('[data-kg]')) {
      el.textContent = `${U.mass(+el.dataset.kg)} ${U.massLabel()}`;
    }
    for (const el of document.querySelectorAll('[data-dims]')) {
      el.textContent = U.dims(JSON.parse(el.dataset.dims));
    }
  }

  root.addEventListener('click', (e) => {
    const b = e.target.closest('button[data-unit]');
    if (b) U.set(b.dataset.unit);
  });

  U.onChange(paint);
  paint();
</script>
