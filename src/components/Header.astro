---
import UnitToggle from './UnitToggle.astro';

/* Three nav items. No Airlines index at launch — docs/15-sitemap.md. */
const path = Astro.url.pathname;
const nav = [
  { href: '/bags/', label: 'Bags' },
  { href: '/guide/', label: 'Guide' },
  { href: '/check/', label: 'Check a bag' },
];
---
<header class="border-b border-rule bg-surface">
  <div class="mx-auto max-w-page px-6 flex items-center gap-8 h-16">
    <a href="/" class="font-bold text-lg tracking-tight text-ink no-underline hover:text-blue">Sizer</a>
    <nav class="flex gap-6 mr-auto">
      {nav.map((n) => (
        <a
          href={n.href}
          aria-current={path.startsWith(n.href) ? 'page' : undefined}
          class="text-[0.9375rem] no-underline text-ink-2 hover:text-blue aria-[current=page]:text-ink aria-[current=page]:font-semibold"
        >{n.label}</a>
      ))}
    </nav>
    <UnitToggle />
  </div>
</header>
