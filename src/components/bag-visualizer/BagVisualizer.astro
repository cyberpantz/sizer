---
import type { BagVisualizerProps } from './types';
import { fareLabel } from '../../ui/fare.mjs';

type Coverage = {
  pass: number;
  of: number;
  unknown: number;
};

type AirlineOption = {
  iata: string;
  name: string;
  defaultFare: string;
  fares: string[];
};

type Props = BagVisualizerProps & {
  airlines: AirlineOption[];
  bagForFit: Record<string, unknown>;
  coverage: Coverage;
  promotable: boolean;
  tone: 'green' | 'amber' | 'red';
  pct: number;
};

const {
  slug,
  name,
  dimensions,
  dimensionSource,
  type,
  wheels,
  soft,
  expandsCm = 0,
  airlines,
  bagForFit,
  coverage: cov,
  promotable,
  tone,
  pct,
} = Astro.props as Props;

const BAR = { green: 'bg-green', amber: 'bg-amber', red: 'bg-red' };

const fmt = (v: number) => v.toFixed(1).replace(/\.0$/, '');
const dimsJson = JSON.stringify([dimensions.heightCm, dimensions.widthCm, dimensions.depthCm]);
const baseProps = JSON.stringify({ slug, name, dimensions, dimensionSource, type, expandsCm, wheels, soft });
const airlinesJson = JSON.stringify(airlines);
const bagForFitJson = JSON.stringify(bagForFit);
const fareLabelsJson = JSON.stringify(
  Object.fromEntries(airlines.flatMap((a) => a.fares.map((f) => [f, fareLabel(f, null)])))
);

const showUnspecified = dimensionSource === 'maker_unspecified';
const showReview = dimensionSource === 'review';
const typeLabel = type.charAt(0).toUpperCase() + type.slice(1);

const describe = `${type} measuring ${fmt(dimensions.heightCm)} by ${fmt(dimensions.widthCm)} by ${fmt(dimensions.depthCm)} centimetres on the outside.`;
---

{/* THE ROOT IS `contents`, NOT A CARD.
    The picker and the size comparison belong beside the reader's other
    numbers, and the 3D stage belongs in the wide column — but the client
    script addresses everything through `root.querySelector`, so they have to
    stay inside one element. `display: contents` resolves that: the DOM keeps
    one root, and the three parts below become grid items of the PAGE grid,
    each carrying its own card. */}
<aside
  class="bag-visualizer contents"
  data-bag-visualizer
  data-base-props={baseProps}
  data-airlines={airlinesJson}
  data-bag-for-fit={bagForFitJson}
  data-fare-labels={fareLabelsJson}
>
  <div
    data-viz-picker
    class="order-1 rounded-card border border-rule bg-surface px-3 py-3 shadow-panel lg:col-start-1"
  >
    <p class="text-[0.6875rem] font-semibold uppercase tracking-wide text-muted">Check against an airline</p>
    <div class="mt-2 grid gap-2 sm:grid-cols-2">
      <label class="block">
        <span class="mb-1 block text-[0.75rem] text-ink-2">Airline</span>
        <select
          data-airline-select
          class="min-h-10 w-full rounded-chip border border-rule bg-surface px-3 py-2 text-[0.875rem] text-ink"
        >
          <option value="">Select an airline…</option>
          {airlines.map((a) => (
            <option value={a.iata}>{a.name}</option>
          ))}
        </select>
      </label>
      <label class="block">
        <span class="mb-1 block text-[0.75rem] text-ink-2">Fare</span>
        <select
          data-fare-select
          disabled
          class="min-h-10 w-full rounded-chip border border-rule bg-surface px-3 py-2 text-[0.875rem] text-ink disabled:cursor-not-allowed disabled:opacity-50"
        >
          <option value="">Choose airline first</option>
        </select>
      </label>
    </div>
  </div>

  <div
    data-viz-stage-col
    class="order-2 overflow-hidden rounded-card border border-rule bg-surface shadow-panel lg:col-start-2 lg:row-start-1 lg:row-span-3 lg:sticky lg:top-6 lg:self-start"
  >
  <div data-viz-shell class="bg-surface-2 px-3 py-4">
  {/* A HEIGHT, NOT AN ASPECT RATIO.
      This was `aspect-[4/5] w-full` with a min-height, a breakpoint min-height
      and a max-height on top. aspect-ratio derives height from WIDTH, so on a
      wide card it asked for 1.25x the card width — far more than the scene ever
      uses — and then three clamps argued about it. The canvas is inset-0 inside
      this box and dutifully filled all of it, which is the dead space under the
      bag: the camera was fitting correctly into a container that was simply too
      tall.
      A gate sizer is 55 x 40 — mildly portrait, and its size does not depend on
      how wide the reader's window is. So state the height directly. */}
  <div
    data-stage
    class="relative h-[min(24rem,58vh)] w-full overflow-hidden rounded-lg bg-surface sm:h-[26rem] lg:h-[30rem]"
  >
    <div
      data-empty-state
      class="absolute inset-0 z-0 grid place-items-center px-6 text-center"
    >
      <div class="max-w-[16rem]">
        <div class="mx-auto mb-4 flex h-16 w-16 items-center justify-center rounded-full border-2 border-dashed border-muted bg-surface">
          <svg class="h-8 w-8 text-muted" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true">
            <rect x="4" y="6" width="16" height="14" rx="1" />
            <path d="M8 6V4h8v2M4 10h16" />
          </svg>
        </div>
        <p class="text-[0.9375rem] font-semibold text-ink">Pick an airline to compare</p>
        <p class="mt-1 text-[0.8125rem] leading-snug text-muted">
          We will show your bag's outside size against that airline's gate sizer frame.
        </p>
      </div>
    </div>

    <div
      data-viz-focus
      hidden
      tabindex="0"
      role="application"
      aria-label="3D fit comparison. Hover for bag dimensions. Press 1 for front, 2 for side, 3 for top."
      class="group absolute inset-0 z-10 outline-none focus-visible:ring-2 focus-visible:ring-blue focus-visible:ring-offset-2 focus-visible:ring-offset-surface-2"
    >
      <canvas class="absolute inset-0 h-full w-full opacity-0 transition-opacity duration-300" aria-hidden="true"></canvas>

      <div
        data-measure-overlay-wrap
        class="pointer-events-none absolute inset-0 opacity-100 transition-opacity duration-200 [@media(hover:hover)]:opacity-0 [@media(hover:hover)]:group-hover:opacity-100 [@media(hover:hover)]:group-focus-within:opacity-100"
      >
        <svg
          data-measure-overlay
          class="absolute inset-0 h-full w-full text-ink-2"
          aria-hidden="true"
        >
          <defs>
            {/* refX is the TIP, not the middle. The path's point is at (10, 5), so
                anchoring at refX="5" hung half an arrowhead past each end of the
                line — the arrows sat somewhere other than where the measurement
                actually stops. */}
            <marker id="viz-arrow" viewBox="0 0 10 10" refX="10" refY="5" markerWidth="6" markerHeight="6" orient="auto-start-reverse">
              <path d="M 0 0 L 10 5 L 0 10 z" fill="currentColor" />
            </marker>
          </defs>
          <g data-measure-lines></g>
        </svg>

        <div data-measure-labels class="absolute inset-0">
          <div
            data-axis-label="height"
            class="absolute -translate-x-1/2 -translate-y-1/2 rounded-chip border border-rule bg-surface px-2 py-1 text-center shadow-panel"
          >
            <span class="block text-[0.625rem] font-semibold uppercase tracking-wide text-muted">Height</span>
            <span class="font-mono text-[0.8125rem] font-semibold" data-cm={dimensions.heightCm}>{fmt(dimensions.heightCm)} cm</span>
          </div>
          <div
            data-axis-label="width"
            class="absolute -translate-x-1/2 -translate-y-1/2 rounded-chip border border-rule bg-surface px-2 py-1 text-center shadow-panel"
          >
            <span class="block text-[0.625rem] font-semibold uppercase tracking-wide text-muted">Width</span>
            <span class="font-mono text-[0.8125rem] font-semibold" data-cm={dimensions.widthCm}>{fmt(dimensions.widthCm)} cm</span>
          </div>
          <div
            data-axis-label="depth"
            class="absolute -translate-x-1/2 -translate-y-1/2 rounded-chip border border-rule bg-surface px-2 py-1 text-center shadow-panel"
          >
            <span class="block text-[0.625rem] font-semibold uppercase tracking-wide text-muted">Depth</span>
            <span class="font-mono text-[0.8125rem] font-semibold" data-cm={dimensions.depthCm}>{fmt(dimensions.depthCm)} cm</span>
            {expandsCm > 0 && (
              <span class="mt-0.5 block text-[0.625rem] font-semibold text-amber">Expander: +{expandsCm}</span>
            )}
          </div>
        </div>
      </div>

    </div>

    <p class="sr-only">{describe}</p>
    <p data-viz-status class="sr-only" aria-live="polite"></p>
  </div>

  <p
    data-stage-caption
    hidden
    class="mt-3 px-1 text-center text-[0.75rem] leading-relaxed text-muted"
  >
    <strong class="text-ink">Blue tint</strong> — your bag.
    <span class="text-muted"> · </span>
    <strong class="text-ink">Slate frame</strong> — the gate sizer.
    <span class="text-muted"> · </span>
    The bag slides in automatically.
    <span class="text-muted"> · </span>
    <span class="hidden [@media(hover:hover)]:inline">Hover for dimensions.</span>
  </p>
  </div>

  <div data-view-controls hidden class="flex flex-wrap gap-2 border-t border-rule bg-surface px-3 pb-3 pt-3">
    <button type="button" data-view="front" aria-pressed="false"
      class="min-h-9 cursor-pointer rounded-chip border border-rule px-2.5 py-1.5 text-[0.8125rem] font-semibold text-ink-2 hover:border-ink-2 hover:text-ink aria-pressed:border-blue aria-pressed:bg-blue-wash aria-pressed:text-blue">
      Front
    </button>
    <button type="button" data-view="side" aria-pressed="false"
      class="min-h-9 cursor-pointer rounded-chip border border-rule px-2.5 py-1.5 text-[0.8125rem] font-semibold text-ink-2 hover:border-ink-2 hover:text-ink aria-pressed:border-blue aria-pressed:bg-blue-wash aria-pressed:text-blue">
      Side
    </button>
    <button type="button" data-view="top" aria-pressed="false"
      class="min-h-9 cursor-pointer rounded-chip border border-rule px-2.5 py-1.5 text-[0.8125rem] font-semibold text-ink-2 hover:border-ink-2 hover:text-ink aria-pressed:border-blue aria-pressed:bg-blue-wash aria-pressed:text-blue">
      Top
    </button>
    <button type="button" data-outline-toggle aria-pressed="false"
      class="min-h-9 cursor-pointer rounded-chip border border-rule px-2.5 py-1.5 text-[0.8125rem] font-semibold text-ink-2 hover:border-ink-2 hover:text-ink aria-pressed:border-blue aria-pressed:bg-blue-wash aria-pressed:text-blue">
      Outline
    </button>
  </div>
  </div>

  <div
    data-viz-results
    class="order-3 overflow-hidden rounded-card border border-rule bg-surface shadow-panel lg:col-start-1"
  >
  <div
    data-limits-compare
    hidden
    class="px-4 py-4"
  >
    <p class="text-[0.8125rem] font-semibold uppercase tracking-wide text-muted">Compare sizes</p>
    <p data-limits-heading class="mt-1 text-[0.9375rem] font-semibold text-ink"></p>
    <div class="mt-3 overflow-hidden rounded-chip border border-rule">
      <div class="grid grid-cols-[4.75rem_1fr_1fr] gap-x-2 border-b border-rule bg-surface-2 px-3 py-2 text-[0.6875rem] font-semibold uppercase tracking-wide text-muted">
        <span></span>
        <span>Your bag</span>
        <span>Airline limit</span>
      </div>
      <div data-limits-rows class="divide-y divide-rule"></div>
      <div data-limits-linear hidden class="grid grid-cols-[4.75rem_1fr_1fr] gap-x-2 border-t border-rule px-3 py-2.5 text-[0.8125rem]">
        <span class="font-semibold text-muted">Total</span>
        <span class="font-mono font-semibold text-ink" data-linear-bag></span>
        <span class="font-mono font-semibold text-ink" data-linear-limit></span>
      </div>
      <p data-limits-weight hidden class="border-t border-rule px-3 py-2.5 text-[0.8125rem] text-ink-2">
        Weight limit: <span class="font-mono font-semibold text-ink" data-limits-weight-val></span>
        <span data-limits-weight-shared hidden class="text-muted"> · shared with personal item</span>
      </p>
    </div>
    <p data-limits-note hidden class="mt-2 text-[0.8125rem] text-muted"></p>
  </div>

  <p
    data-viz-verdict
    hidden
    class="border-t border-rule px-4 py-3 text-[0.9375rem] font-semibold leading-snug text-ink"
    aria-live="polite"
  ></p>

  {(showUnspecified || showReview) && (
    <p class="border-t border-rule px-4 py-3 text-[0.8125rem] text-amber">
      {showReview
        ? 'Review-sourced dimensions — dashed rules indicate lower confidence.'
        : 'Shown, not recommended — dashed rules indicate an unspecified overall figure.'}
    </p>
  )}

  <div class="border-t border-rule px-4 py-4 [&:first-child]:border-t-0">
    <div class="flex items-end justify-between gap-4">
      <div>
        <p class="text-[1.75rem] font-bold leading-none tracking-tight tabular-nums">
          {cov.pass}<span class="text-muted">/{cov.of}</span>
        </p>
        <p class="mt-1 text-[0.8125rem] text-ink-2">airlines it gets past</p>
      </div>
      <span class="mb-0.5 block h-2 w-28 shrink-0 overflow-hidden rounded-full bg-surface-2 sm:w-36">
        <span class={`block h-full rounded-full ${BAR[tone]}`} style={`width:${pct}%`}></span>
      </span>
    </div>
    {cov.unknown > 0 && (
      <p class="mt-2 text-[0.75rem] text-muted">
        {cov.unknown} more we cannot answer for yet, and they are left out of
        that fraction rather than counted as passes.
      </p>
    )}
    {!promotable && (
      <p class="mt-3 rounded-chip bg-amber-wash p-2.5 text-[0.8125rem] text-amber">
        Shown, not recommended — the dimension above is not the maker's own
        overall figure.
      </p>
    )}
    <a
      href="/check/"
      class="mt-3 block rounded-chip bg-blue px-4 py-2.5 text-center text-[0.9375rem] font-semibold text-on-blue no-underline hover:bg-blue-hover"
    >Check it against your trip</a>
  </div>
  </div>

  <span data-dims={dimsJson} class="sr-only" aria-hidden="true"></span>
</aside>

<script>
  let dispose = null;
  let catalogue = null;

  function parseJson(el, key) {
    return JSON.parse(el.dataset[key] ?? '{}');
  }

  function fareLabels(root) {
    return parseJson(root, 'fareLabels');
  }

  function airlineOf(root, iata) {
    return parseJson(root, 'airlines').find((a) => a.iata === iata) ?? null;
  }

  function baseProps(root) {
    return parseJson(root, 'baseProps');
  }

  async function loadCatalogue() {
    if (catalogue) return catalogue;
    const res = await fetch('/catalogue.json');
    if (!res.ok) throw new Error(`catalogue unavailable (${res.status})`);
    catalogue = await res.json();
    return catalogue;
  }

  function populateFares(root, airline) {
    const fareSelect = root.querySelector('[data-fare-select]');
    if (!fareSelect || !airline) return;

    const labels = fareLabels(root);
    fareSelect.innerHTML = '';
    for (const fare of airline.fares) {
      const opt = document.createElement('option');
      opt.value = fare;
      opt.textContent = labels[fare] ?? fare.replace(/_/g, ' ');
      fareSelect.appendChild(opt);
    }
    fareSelect.value = airline.defaultFare;
    fareSelect.disabled = false;
  }

  function showEmpty(root) {
    root.querySelector('[data-empty-state]')?.removeAttribute('hidden');
    root.querySelector('[data-viz-focus]')?.setAttribute('hidden', '');
    root.querySelector('[data-limits-compare]')?.setAttribute('hidden', '');
    root.querySelector('[data-viz-verdict]')?.setAttribute('hidden', '');
    root.querySelector('[data-view-controls]')?.setAttribute('hidden', '');
    root.querySelector('[data-stage-caption]')?.setAttribute('hidden', '');
    root.dataset.ready = '';
  }

  function showLoaded(root) {
    root.querySelector('[data-empty-state]')?.setAttribute('hidden', '');
    root.querySelector('[data-viz-focus]')?.removeAttribute('hidden');
    root.querySelector('[data-limits-compare]')?.removeAttribute('hidden');
    root.querySelector('[data-viz-verdict]')?.removeAttribute('hidden');
    root.querySelector('[data-view-controls]')?.removeAttribute('hidden');
    root.querySelector('[data-stage-caption]')?.removeAttribute('hidden');
  }

  async function mountForSelection(root) {
    const iata = root.querySelector('[data-airline-select]')?.value;
    const fare = root.querySelector('[data-fare-select]')?.value;
    if (!iata || !fare) {
      dispose?.();
      dispose = null;
      showEmpty(root);
      return;
    }

    const airline = airlineOf(root, iata);
    if (!airline) return;

    const data = await loadCatalogue();
    const carrier = data.carriers.find((c) => c.iata === iata);
    if (!carrier?.record) return;

    dispose?.();
    dispose = null;

    showLoaded(root);

    await new Promise((resolve) => requestAnimationFrame(() => requestAnimationFrame(resolve)));

    const props = baseProps(root);
    const { mountFitVisualizer } = await import('./BagVisualizer.client');
    dispose =
      (await mountFitVisualizer(root, {
        ...props,
        bag: parseJson(root, 'bagForFit'),
        carrierRecord: carrier.record,
        fare,
        carrierName: airline.name,
      })) ?? null;

    if (!dispose) {
      root.querySelector('[data-viz-verdict]').textContent =
        'Could not load the 3D view in this browser.';
    }
  }

  function wire(root) {
    const airlineSelect = root.querySelector('[data-airline-select]');
    const fareSelect = root.querySelector('[data-fare-select]');

    airlineSelect?.addEventListener('change', () => {
      const iata = airlineSelect.value;
      if (!iata) {
        fareSelect.innerHTML = '<option value="">Choose airline first</option>';
        fareSelect.disabled = true;
        dispose?.();
        dispose = null;
        showEmpty(root);
        return;
      }
      const airline = airlineOf(root, iata);
      populateFares(root, airline);
      mountForSelection(root);
    });

    fareSelect?.addEventListener('change', () => mountForSelection(root));
  }

  for (const root of document.querySelectorAll('[data-bag-visualizer]')) {
    wire(root);
  }

  document.addEventListener('astro:before-swap', () => {
    dispose?.();
    dispose = null;
  });
</script>
