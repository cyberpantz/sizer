---
import Base from '../layouts/Base.astro';
import { loadCarriers } from '../lib/data.mjs';

const carriers = await loadCarriers();
const answerable = carriers.filter((c) => !c.cabin_unknown).length;

/* Ported from mockup/check.html, which this page had drifted a long way from.
   The mockup's shape is the product: a two-column layout with the inputs on
   the left and ONE answer card on the right, carrying a verdict word in
   display type, a per-leg table with the binding leg highlighted, and — the
   part nothing else on the site does — the biggest bag that survives the whole
   itinerary.

   What is deliberately NOT ported:

   - Airport codes on each leg. The mockup shows "ITH → JFK"; we have no
     airport dataset, and typing plausible codes into the design would be
     inventing data on the page whose entire pitch is that it doesn't.
   - "Email me this answer". That needs Resend, which is blocked on the domain.
     A button that does nothing is worse than no button.
   - The remove control's red hover. The mockup tints it red; docs/02 says blue
     is the only interactive colour, and verify-build.mjs enforces it on the
     built HTML. The rule wins over the mockup.
   - Fee figures in the plan panel. Not in the schema, and you already cut the
     invented ones out of the mockup. */

const RISK = [
  {
    id: 'strict',
    label: 'Strict',
    why: 'We ignore how relaxed an airline usually is and go by the published limit alone. Fewer nasty surprises, more bags ruled out.',
  },
  {
    id: 'balanced',
    label: 'Balanced',
    why: 'We weigh the published limit against how often that airline actually checks. This is what most people want.',
  },
  {
    id: 'chance',
    label: "I'll chance it",
    why: "We still show you what's over the limit, but flag the cases where the airline rarely looks. Your call, made with the facts.",
  },
];
---
<Base
  title="Check your whole trip — Sizer"
  description={`One leg being fine doesn't mean the trip is. Add every flight and we'll tell you which one decides, checked against ${answerable} airlines.`}
>
  <div class="mx-auto max-w-page px-6">

    <section class="pt-10 pb-7">
      <h1 class="max-w-[20ch] text-4xl font-semibold leading-[1.12] tracking-tight sm:text-[2.6rem]">
        Check your whole trip
      </h1>
      <p class="mt-2.5 max-w-[62ch] text-lg text-ink-2">
        One leg being fine doesn't mean the trip is. Add every flight and we'll
        tell you which one decides, and the biggest bag that survives all of
        them.
      </p>
    </section>

    <div id="check" data-check class="pb-20">

      {/* The tool needs JavaScript. Say what it does rather than showing an
          empty box — and offer the static route out. */}
      <noscript>
        <p class="rounded-card border border-rule bg-surface p-5 text-ink-2">
          This tool runs in your browser and needs JavaScript. You can still{' '}
          <a href="/bags/" class="text-blue hover:text-blue-hover hover:underline underline-offset-2">browse bags by how widely they fit</a>.
        </p>
      </noscript>

      <div data-loading class="rounded-card border border-rule bg-surface p-5 text-muted">
        Loading {answerable} airlines…
      </div>

      <div data-ui hidden class="grid items-start gap-7 lg:grid-cols-[minmax(0,26rem)_minmax(0,1fr)]">

        <div>
          {/* FLIGHTS FIRST, AND THAT IS AN ARGUMENT ABOUT WHAT IS KNOWABLE.

              Frank: "What if we swapped the order of Flights and Bags, so a
              user adds their flights and fare class then adds their bags. We
              could impose some sort of rules that way."

              The old order asked "which bag?" before the page knew whether the
              ticket allowed one. On a Ryanair Basic fare the honest first
              sentence is "this fare includes no cabin bag" — knowable before
              the reader picks anything — so asking for a bag first meant
              collecting input we might have to invalidate.

              And it is what lets the bag panel be SHAPED by the answer rather
              than merely validated against it. Once the fare is known, "you get
              one cabin bag and one personal item" is a fact, so the slots can
              start as the fare's own shape instead of a generic "add a bag"
              that can produce a set no ticket permits.

              The z-index swaps with the order. Both panels open a combobox that
              overhangs the panel below it, so whichever is on top needs the
              higher stacking context — this was z-20 on bags purely because
              bags used to be first. */}
          <section class="rounded-card border border-rule bg-surface shadow-panel">
            <div class="border-b border-rule px-5 py-4">
              <h2 class="text-lg font-semibold">Your flights</h2>
              <p class="mt-0.5 text-[0.9375rem] text-muted">Every leg, in order. The strictest one wins.</p>
            </div>
            <div class="relative z-20 px-5 pt-4 pb-[1.125rem]" data-legbox></div>
          </section>

          <section class="mt-4 rounded-card border border-rule bg-surface shadow-panel">
            <div class="border-b border-rule px-5 py-4">
              <h2 class="text-lg font-semibold">Your bags</h2>
              <p class="mt-0.5 text-[0.9375rem] text-muted" data-bagbox-hint>Add the ones you're choosing between.</p>
            </div>
            <div class="relative z-10 px-5 pt-4 pb-[1.125rem]" data-bagbox></div>
          </section>

          <section class="mt-4 rounded-card border border-rule bg-surface shadow-panel">
            <div class="border-b border-rule px-5 py-4">
              <h2 class="text-lg font-semibold">How much risk will you take?</h2>
            </div>
            <div class="px-5 pt-4 pb-[1.125rem]">
              {/* Server-rendered, so the control exists before the catalogue
                  arrives. The three modes are three engine configurations —
                  same ladder, different gamble ceiling. */}
              <div
                data-risk
                role="group"
                aria-label="Risk tolerance"
                class="flex w-max overflow-hidden rounded-full border border-rule-strong"
              >
                {RISK.map((r, i) => (
                  <button
                    type="button"
                    data-r={r.id}
                    aria-pressed={r.id === 'balanced' ? 'true' : 'false'}
                    data-why={r.why}
                    class={`cursor-pointer px-[1.125rem] py-2.5 text-[0.96875rem] hover:bg-surface-2 hover:text-ink aria-pressed:bg-blue aria-pressed:text-on-blue aria-pressed:hover:bg-blue-hover aria-pressed:hover:text-on-blue${
                      i < RISK.length - 1 ? ' border-r border-rule-strong' : ''
                    }`}
                  >{r.label}</button>
                ))}
              </div>
              <p data-riskwhy class="mt-3 max-w-[46ch] text-[0.9375rem] text-muted"></p>
            </div>
          </section>
        </div>

        <div data-answer aria-live="polite"></div>
      </div>
    </div>

  </div>
</Base>

<script>
  /* The engine runs here unchanged — same module the build uses.
     That is the whole payoff of keeping it pure: no DOM, no I/O, no units, so
     a verdict computed in this browser is byte-identical to one computed at
     build time. */
  import { h, render } from 'preact';
  import Picker from '../components/Picker.jsx';
  import { createEngine, desc, engine as DEFAULT } from '../engine/fit.mjs';
  import { isPromotable, toBag, toCarrier } from '../engine/normalize.mjs';
  import { defaultRoleForNew, pieceOverages } from '../ui/bag-set.mjs';
  import { fareLabel } from '../ui/fare.mjs';
  import {
    decodeCustom,
    defaultShape,
    encodeCustom,
    isCustom,
    shapeOf,
    shapesFor,
    toCustomRecord,
  } from '../ui/custom-bag.mjs';
  import {
    asRole,
    decodeSlot,
    defaultRole,
    encodeSlot,
    ROLE_COPY,
    roleLabel,
    ROLES,
  } from '../ui/role.mjs';
  import {
    SCALE_MAX,
    enforcementLabel,
    enforcementNote,
    enforcementScore,
    strictnessIcon,
    tierIndex,
  } from '../ui/strictness.mjs';
  import { tripEnvelope, SHOWN } from '../ui/trip-envelope.mjs';
  import { createUnits } from '../ui/units.mjs';
  import {
    advisoryLine,
    bandLabel,
    chipLabel,
    fitsWithinLimit,
    resultLabel,
  } from '../ui/verdict.mjs';

  const root = document.querySelector('[data-check]');
  const U = createUnits();

  /* Three engines, not three code paths. Risk changes ONE number — how far over
     a published limit is still worth showing as a risk rather than a refusal —
     and every other rule stays identical, which is why the modes can never
     disagree about anything except that band. */
  const ENGINES = {
    strict: createEngine({ gambleCeiling: () => 0 }),
    balanced: createEngine(),
    chance: createEngine({ gambleCeiling: (s) => DEFAULT.config.gambleCeiling(s) * 1.5 }),
  };

  /* The copy lives on the buttons, rendered from RISK in the frontmatter. A
     second copy in this script is how two explanations of the same control end
     up disagreeing — the exact drift ui/verdict.mjs exists to prevent. */
  const riskWhy = (id) => root.querySelector(`[data-r="${id}"]`)?.dataset.why ?? '';

  const TAG = {
    clears: 'bg-green-wash text-green',
    line: 'bg-lime-wash text-lime',
    likely: 'bg-amber-wash text-amber',
    gamble: 'bg-orange-wash text-orange',
    wont: 'bg-red-wash text-red',
  };
  const EDGE = {
    clears: 'border-l-green',
    line: 'border-l-lime',
    likely: 'border-l-amber',
    gamble: 'border-l-orange',
    wont: 'border-l-red',
  };
  const WORD = {
    clears: 'text-green',
    line: 'text-lime',
    likely: 'text-amber',
    gamble: 'text-orange',
    wont: 'text-red',
  };
  const UNKNOWN_TAG = 'bg-surface-2 text-muted';
  const RISK_LABEL = { strict: 'Strict', balanced: 'Balanced', chance: "I'll chance it" };
  /* The same five bands as CSS custom properties, for SVG attributes — which
     take colours, not utility classes. */
  const INK = {
    clears: 'var(--color-green)',
    line: 'var(--color-lime)',
    likely: 'var(--color-amber)',
    gamble: 'var(--color-orange)',
    wont: 'var(--color-red)',
  };

  const el = (sel) => root.querySelector(sel);
  const esc = (s) =>
    String(s).replace(/[&<>"]/g, (c) => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;' })[c]);

  const dedupeBy = (xs, key) => [...new Map(xs.map((x) => [key(x), x])).values()];

  /* SLOTS, NOT SLUGS. Each entry is { slug, role } — the bag AND what it is
     doing on this trip. A bare slug could only ever ask the overhead question,
     which is the model every competitor is stuck in. */
  const state = { bags: [], legs: [], risk: 'balanced' };
  let DATA = null;
  let CARRIER_ITEMS = [];
  let BAG_ITEMS = [];

  /* ---------- boot ---------- */

  async function boot() {
    const res = await fetch('/catalogue.json');
    if (!res.ok) throw new Error(`catalogue unavailable (${res.status})`);
    DATA = await res.json();

    /* Built ONCE. The picker takes {value,name,code}; rebuilding this array on
       every keystroke would defeat the useMemo inside the component and make
       58 airlines feel like a lag. */
    CARRIER_ITEMS = DATA.carriers.map((c) => ({ value: c.iata, name: c.name, code: c.iata }));
    /* Brand and model in one searchable string, so "away big" and "briggs"
       both land. No code — a bag has no equivalent of an IATA code. */
    /* NOT IN THIS LIST. "Describe your own bag" was an item here for about an
       hour, and Frank's reaction — "sorry how do I create a custom bag?" — is
       the whole review it needed.

       search() sorts an empty query by NAME, so it sat alphabetically between
       Calpak and Eagle Creek, styled identically to a product, reading as a bag
       we sell called "Describe your own bag…". A control you can only find by
       already knowing it is there is not a control. It is now a button beside
       the picker, where the page already puts its other verbs. */
    BAG_ITEMS = DATA.bags.map((b) => ({ value: b.slug, name: `${b.brand} ${b.model}` }));

    /* Registered once, here, NOT in renderInputs — that runs on every state
       change and would stack a listener per render, so one click would fire
       the handler N times and the trip would jump. */
    document.addEventListener('sizer:pick', (e) => {
      const { kind, index, value } = e.detail;
      if (kind === 'bag') {
        const b = bagOf(value);
        if (!b) return;
        /* Choosing a bag RE-DEFAULTS its role, rather than keeping whatever the
           previous occupant of this slot was. Swapping a roller for an
           under-seat bag and silently leaving it marked "Carry-on" would answer
           a question the reader did not ask, and they would have no reason to
           look at a control they never touched. */
        state.bags[index] = { slug: value, role: defaultRole(b) };
      } else {
        const c = carrierOf(value);
        if (!c || !state.legs[index]) return;
        /* Fares do not survive a carrier change — "Priority" means nothing on
           the next airline, and silently keeping it would answer a question
           about a fare that does not exist. */
        state.legs[index] = { iata: c.iata, fare: c.fares[0] };
      }
      draw();
    });

    restore();
    el('[data-loading]').hidden = true;
    el('[data-ui]').hidden = false;

    for (const b of el('[data-risk]').querySelectorAll('[data-r]')) {
      b.addEventListener('click', () => {
        state.risk = b.dataset.r;
        draw();
      });
    }
    U.onChange(draw);
    draw();
  }

  /* The trip lives in the URL, so "copy link" is a real feature rather than a
     button that lies. Also means a reload keeps your itinerary. */
  function restore() {
    const p = new URLSearchParams(location.search);
    /* `away-carryon:p` — slug and role. A link written before roles existed has
       no `:p` on it and decodes to cabin, which is exactly what its sender saw,
       so every permalink already in the wild still resolves to its own answer. */
    const bags = (p.get('bags') ?? '')
      .split(',')
      .filter(Boolean)
      .map(decodeSlot)
      /* A custom bag validates itself — decodeCustom returns null on anything a
         URL can mangle, and a slug we do not hold is dropped exactly as before.
         Both cases fail the same way: the slot disappears rather than the page
         throwing on someone else's link. */
      .filter((x) => (isCustom(x.slug) ? decodeCustom(x.slug) !== null : DATA.bags.some((b) => b.slug === x.slug)))
      .map((x) => ({ ...x, role: asRole(x.role) }));
    const legs = (p.get('legs') ?? '')
      .split(',')
      .filter(Boolean)
      .map((t) => {
        const [iata, fare] = t.split('.');
        const c = DATA.carriers.find((x) => x.iata === iata);
        return c ? { iata, fare: c.fares.includes(fare) ? fare : c.fares[0] } : null;
      })
      .filter(Boolean);

    /* NO BAG IS PRESELECTED. Opening on whatever sorts first in the catalogue
       put a specific product in front of the reader as though it were their
       answer — an accidental endorsement, on a site whose whole claim is that
       it recommends carefully. An empty slot asks the question the page is
       for. */
    state.bags = bags.length ? bags : [{ slug: '', role: 'cabin' }];
    /* NO AIRLINE IS PRESELECTED EITHER.

       This opened on DATA.carriers[0] — Aegean, by alphabet — and that was
       tolerable while flights were the second panel and a bag was the subject.
       Now that flights LEAD and everything below is computed from them, opening
       on an arbitrary carrier would make the whole page an answer about an
       airline the reader never named.

       It is the rule already written three lines above for bags, applied to the
       thing that now decides more: an empty slot asks the question the page is
       for. */
    state.legs = legs.length ? legs : [{ iata: '', fare: '' }];
    if (['strict', 'balanced', 'chance'].includes(p.get('risk'))) state.risk = p.get('risk');
  }

  const permalink = () =>
    `${location.origin}${location.pathname}?bags=${state.bags
      .filter((x) => x.slug)
      .map(encodeSlot)
      .join(',')}` +
    `&legs=${state.legs
      .filter((l) => l.iata)
      .map((l) => `${l.iata}.${l.fare}`)
      .join(',')}&risk=${state.risk}`;

  /* ---------- model ---------- */

  /* A CUSTOM BAG IS A BAG. Resolved here rather than special-cased at every
     call site, so score(), the card header, the comparator and the leg table
     all work on it without knowing it was typed rather than chosen. The shape
     is the same shape the catalogue ships. */
  /* Legs the reader has actually named an airline for. Every computation runs
     on these; the empty slots are a form state, not part of the trip. */
  const flownLegs = () => state.legs.filter((l) => l.iata && carrierOf(l.iata));

  const bagOf = (slug) => {
    if (isCustom(slug)) {
      const rec = toCustomRecord(slug);
      return rec && { ...rec, external_cm: rec.external_cm.v, weight_kg: null };
    }
    return DATA.bags.find((b) => b.slug === slug);
  };
  const carrierOf = (iata) => DATA.carriers.find((c) => c.iata === iata);

  const toEngineBag = (b) =>
    toBag({ ...b, external_cm: { v: b.external_cm }, dim_source: b.dim_source ?? undefined });

  /* THE ALLOWANCE THIS SLOT IS BEING JUDGED AGAINST.
     One helper, because six places on this page draw or explain "the limit" and
     six copies of `role === 'personal' ? … : …` is how the picture ends up
     disagreeing with the verdict printed beside it. */
  const allowanceFor = (carrier, role) =>
    (role === 'personal' ? carrier?.allowances?.personal : carrier?.allowance) ?? null;

  /* Takes a SLOT — the bag and the role it is playing — because the same
     object gets a different answer depending on which allowance it is being
     held against, and on some airlines a wildly different one. */
  function score({ slug, role = 'cabin' }) {
    const E = ENGINES[state.risk] ?? ENGINES.balanced;
    const bag = toEngineBag(bagOf(slug));
    const rows = flownLegs().map((leg, i) => {
      const rec = carrierOf(leg.iata).record;
      const carrier = toCarrier(rec, leg.fare);
      return { i, leg, carrier, record: rec, result: E.evaluate(bag, carrier, { role }) };
    });
    /* Which leg binds is the ENGINE's call, not this page's.

       A hand-rolled `reduce` on delta_cm lived here and got it wrong: a leg we
       cannot answer for came back with `band: null`, ranked below every scored
       leg, and lost — so a trip through an airline nobody has researched
       reported a confident verdict from the other legs. bindingLeg() already
       returns early on an unknown or a no-cabin-bag leg, for exactly this
       reason. Same carrier objects go in, so identity finds the row again. */
    const bound = E.bindingLeg(bag, rows.map((r) => r.carrier), { role });
    const worst = rows.find((r) => r.carrier === bound?.carrier) ?? rows[0];

    return { bag, rows, worst, role };
  }

  /* ---------- inputs ---------- */

  /* WHICH BAG IS WHICH — one control per bag, and it is a CORRECTION, not a
     question.

     The role is already defaulted from the bag's own record, so a reader who
     never touches this still gets a sensible answer. That matters more than it
     sounds: a control that must be answered before the page will say anything
     turns a lookup into an interview, and this page's entire pitch is that it
     is not one.

     Why it exists at all: the same object is a different question depending on
     what you are carrying it as. A 40 × 30 × 20 packing cube is an overhead bag
     by construction and a personal item on Ryanair Basic — and on Singapore the
     under-seat slot is ten centimetres deep, so the two answers are not close.
     Every competitor prints BOTH percentages side by side rather than asking,
     which is a question no traveller has: nobody is undecided about which of
     their two bags is going overhead.

     Rendered only once a bag is chosen. On an empty slot it would be a control
     for an object that does not exist yet. */
  /* THE ONE PLACE ON THIS SITE A READER TYPES A MEASUREMENT.

     Three inputs and a shape selector. The shape PREFILLS the inputs and then
     gets out of the way — it saves typing, it is not a claim about what a tote
     measures, and the value reaching the engine is whatever is left in the
     boxes. That distinction is why this feature is allowed to exist at all on a
     site whose rule is that we never print a figure we cannot source: we are
     not sourcing it, the reader is.

     IN THE READER'S OWN UNITS. Someone with the toggle on imperial types 16,
     not 40.6, and U.toCm sends centimetres to the engine — the one conversion
     factor on the site, so a bag typed in inches cannot end up judged in
     centimetres. That failure would be invisible: 22 would simply read "Over"
     everywhere and look like an answer.

     `step` is 0.5 in centimetres and 0.25 in inches — fine enough to matter at
     a gate, coarse enough not to imply a tape measure nobody used. */
  /* THE WAY IN, AND THE WAY BACK OUT.
     
     A visible button under the picker, in the idiom this page already uses for
     its verbs ("+ Add another flight"). It replaced a line item in the bag
     dropdown, which Frank could not find — because search() orders an empty
     query by name, so it sat between Calpak and Eagle Creek looking like a
     product we sell.
     
     THE REVERSE LINK MATTERS AS MUCH. Once a slot is custom, the picker is
     showing shapes rather than the catalogue, and without a way back a reader
     who clicked this by accident is stuck describing a bag they did not want to
     describe. Every door on this page opens both ways. */
  const customToggle = (slot, i) =>
    isCustom(slot.slug)
      ? `<button type="button" data-uncustom="${i}"
           class="mt-1.5 cursor-pointer rounded-chip bg-transparent px-0 py-0.5 text-[0.8125rem] text-blue hover:underline underline-offset-2">
           Pick from our catalogue instead</button>`
      : `<button type="button" data-customise="${i}"
           class="mt-1.5 cursor-pointer rounded-chip bg-transparent px-0 py-0.5 text-[0.8125rem] text-blue hover:underline underline-offset-2">
           ${slot.slug ? 'Describe a different bag' : 'Describe your own bag'}</button>`;

  /** The label the picker would have shown in this slot. One definition, so
   *  the two modes cannot describe the same row differently. */
  const bagLabel = (i) => (state.bags.length > 1 ? `Bag ${i + 1}` : 'Your bag');

  const customEditor = (slot, i) => {
    const parsed = decodeCustom(slot.slug);
    if (!parsed) return '';
    const step = U.unit === 'cm' ? 0.5 : 0.25;
    const axis = ['Longest', 'Second', 'Shortest'];
    /* STYLED AS THE PRIMARY CONTROL, because in this mode it IS the primary
       control — it stands where the combobox stands, carries the same label,
       and its select takes the same weight as the picker's input. An inset
       grey panel would read as a detail attached to something else, and there
       is nothing else: the picker is not rendered while this is. */
    return `<label class="block text-[0.8125rem] font-medium text-muted" for="shape-${i}">${esc(bagLabel(i))}</label>
      <select id="shape-${i}" data-shape="${i}"
        class="mt-1 w-full cursor-pointer rounded-chip border border-rule-strong bg-surface py-2 pr-3 pl-3 text-[1.03125rem] font-semibold text-ink hover:border-blue focus:border-blue focus:outline-none">
        ${/* The role's own shapes, PLUS whatever they already picked. A duffel
             is not an answer to "what is your personal item", so the list is
             filtered — but a reader who described a tote and then switched the
             role to Carry-on must not find their own choice missing from the
             control describing it. Their dimensions survive a role change
             untouched; only which allowance they are measured against moves. */
          [
            ...shapesFor(slot.role),
            ...(shapeOf(parsed.shape) && shapeOf(parsed.shape).role !== slot.role
              ? [shapeOf(parsed.shape)]
              : []),
          ]
            .map(
              (sh) =>
                `<option value="${esc(sh.id)}"${sh.id === parsed.shape ? ' selected' : ''}>${esc(sh.label)}</option>`
            )
            .join('')}
      </select>
      <div class="mt-2 grid grid-cols-3 gap-2">
        ${parsed.cm
          .map(
            (cm, ax) => `<label class="block">
              <span class="block text-[0.75rem] text-muted">${axis[ax]}</span>
              <input type="number" inputmode="decimal" min="1" step="${step}"
                data-dim="${i}" data-axis="${ax}" value="${U.len(cm)}"
                aria-label="${axis[ax]} side in ${esc(U.lenLabel())}"
                class="mt-0.5 w-full rounded-chip border border-rule-strong bg-surface px-2 py-1.5 text-right font-mono text-[0.875rem] hover:border-blue focus:border-blue focus:outline-none" />
            </label>`
          )
          .join('')}
      </div>
      <p class="mt-1.5 text-[0.75rem] leading-snug text-muted">
        ${esc(U.lenLabel())}. These are your figures, not ours — measure the outside,
        handles and wheels included, the way a gate does.
      </p>`;
  };

  const roleControl = (slot, i) =>
    `<div role="group" aria-label="What ${esc(bagOf(slot.slug)?.model ?? 'this bag')} is on this trip"
       class="mt-2 inline-flex overflow-hidden rounded-chip border border-rule">
      ${ROLES.map(
        (r) => `<button type="button" data-role="${r}" data-slot="${i}"
          aria-pressed="${slot.role === r}"
          title="${esc(ROLE_COPY[r].where)}"
          class="cursor-pointer border-0 bg-transparent px-2.5 py-[0.3125rem] text-[0.8125rem] leading-none text-muted
                 hover:text-blue
                 aria-pressed:bg-surface-2 aria-pressed:font-medium aria-pressed:text-ink
                 aria-pressed:hover:text-blue">${esc(ROLE_COPY[r].label)}</button>`
      ).join('')}
    </div>`;

  function renderInputs() {
    /* THE BAG IS A CONTROL, NOT A CAPTION.

       This panel used to render the chosen bag as static text with a remove
       button that only appeared once a second bag existed. So the page opened
       on whatever sorted first in the catalogue — an Amazon Basics spinner —
       and there was no way to change it. The primary question this page asks,
       "which bag do you own", had no input at all.

       Same Picker as the airlines. Two pickers would drift; the only
       difference here is the label and which slot the answer lands in. */
    el('[data-bagbox]').innerHTML =
      state.bags
        .map((slot, i) => {
          const b = slot.slug ? bagOf(slot.slug) : null;
          const { worst } = b ? score(slot) : { worst: null };
          const band = worst?.result.band;
          /* ONE SLOT, ONE INPUT.

             Frank: "It doesn't make sense to both show the Baggage combobox and
             the custom bag form. If one is active the other is inactive."

             Both were rendered, both were live, and the combobox would happily
             overwrite a described bag with a catalogue one — two controls
             fighting over a single answer, with no way to tell which was in
             charge. A slot is now in exactly one MODE: the picker, or the
             description. `customToggle` is the switch between them, and it is
             the only thing on the row that appears in both. */
          const custom = isCustom(slot.slug);
          const chip = b ? chipLabel(worst?.result) : null;
          return `<div class="border-b border-rule py-3 last:border-b-0">
            <div class="flex items-start gap-2">
              <div class="min-w-0 flex-1">
                ${custom ? customEditor(slot, i) : `<div data-bag-mount="${i}"></div>`}
                ${customToggle(slot, i)}
              </div>
              ${
                /* NO CHIP WHEN THERE IS NO STATUS. chipLabel returns null for
                   an airline that publishes nothing, an unresearched leg or a
                   defunct carrier — none of which is a fact about this bag, and
                   none of which fits in a pill. The answer card below says
                   which airline and why. */
                chip
                  ? `<span class="mt-6 shrink-0 rounded-full px-2.5 py-1 text-[0.875rem] font-semibold ${
                      band ? TAG[band] : UNKNOWN_TAG
                    }">${esc(chip)}</span>`
                  : ''
              }
              ${
                state.bags.length > 1
                  ? `<button type="button" data-rmbag="${i}" aria-label="Remove bag ${i + 1}"
                       class="mt-5 shrink-0 cursor-pointer rounded-chip px-2.5 py-2 text-xl leading-none text-muted hover:bg-blue-wash hover:text-blue">×</button>`
                  : ''
              }
            </div>
            ${
              b
                ? `${
                    /* The dimensions line is a READOUT of the catalogue's
                       figure. On a described bag the same numbers are already
                       sitting in the inputs above, editable — printing them
                       again underneath is the row telling you twice. */
                    custom
                      ? ''
                      : `<p class="mt-1 font-mono text-[0.84375rem] text-muted">${esc(U.dims(b.external_cm))}${
                          b.weight_kg
                            ? ` · ${esc(U.mass(b.weight_kg))} ${esc(U.massLabel())} empty`
                            : ''
                        }</p>`
                  }
                   ${roleControl(slot, i)}`
                : ''
            }
          </div>`;
        })
        .join('') +
      `<button type="button" data-addbag
         class="mt-3 min-h-12 w-full cursor-pointer rounded-chip border border-dashed border-rule-strong p-3 font-semibold text-blue hover:border-blue hover:bg-blue-wash">
         + Add another bag to compare</button>`;

    el('[data-legbox]').innerHTML =
      state.legs
        .map((leg, i) => {
          /* AN EMPTY LEG IS A LEGITIMATE STATE NOW. The page opens on one, and
             it renders the picker and nothing else — no fare dropdown for an
             airline nobody has chosen, and no regional-jet warning about a
             fleet we have not been told about. */
          const c = leg.iata ? carrierOf(leg.iata) : null;
          const regional = c?.record.operates_regional_jets === true;
          return `<div class="grid grid-cols-[1.625rem_1fr_auto] items-start gap-3 border-b border-rule py-3 last:border-b-0">
            <span class="mt-0.5 grid h-[1.625rem] w-[1.625rem] place-items-center rounded-full bg-surface-2 font-mono text-[0.875rem] text-muted">${i + 1}</span>
            <span class="min-w-0">
              <div data-carrier-mount="${i}"></div>
              ${
                c
                  ? `<select data-leg-fare="${i}" aria-label="Fare for flight ${i + 1}"
                class="mt-1.5 w-full cursor-pointer rounded-chip border border-rule-strong bg-surface px-2.5 py-1.5 text-[0.90625rem] text-muted">
                ${c.fares
                  .map(
                    (f) =>
                      `<option value="${esc(f)}"${f === leg.fare ? ' selected' : ''}>${esc(fareLabel(f, c.fare_names?.[f]))}</option>`
                  )
                  .join('')}
              </select>`
                  : ''
              }
              ${
                regional
                  ? `<span class="mt-1.5 block text-[0.90625rem] leading-snug text-amber">⚠ Often a regional jet. The overhead bins are smaller than the airline's own limit, so a full-size bag is frequently taken at the door.</span>`
                  : ''
              }
            </span>
            ${
              state.legs.length > 1
                ? `<button type="button" data-rmleg="${i}" aria-label="Remove flight ${i + 1}"
                     class="cursor-pointer rounded-chip px-2.5 py-2 text-xl leading-none text-muted hover:bg-blue-wash hover:text-blue">×</button>`
                : ''
            }
          </div>`;
        })
        .join('') +
      `<button type="button" data-addleg
         class="mt-3 min-h-12 w-full cursor-pointer rounded-chip border border-dashed border-rule-strong p-3 font-semibold text-blue hover:border-blue hover:bg-blue-wash">
         + Add another flight</button>`;

    el('[data-riskwhy]').textContent = riskWhy(state.risk);
    for (const b of el('[data-risk]').querySelectorAll('[data-r]')) {
      b.setAttribute('aria-pressed', String(b.dataset.r === state.risk));
    }
    wireInputs();
  }

  function wireInputs() {
    /* By INDEX, not by slug. Filtering on slug removed every copy of a bag, so
       picking the same model into two slots to compare fares — a perfectly
       reasonable thing to do — made one × delete both. */
    for (const b of root.querySelectorAll('[data-customise]')) {
      b.addEventListener('click', () => {
        const i = +b.dataset.customise;
        /* Seeded from the role the slot is ALREADY in, so a reader who set
           "Personal item" and then chose to describe it gets tote-sized
           defaults rather than suitcase-sized ones. */
        const role = state.bags[i]?.role ?? 'cabin';
        const shape = shapeOf(defaultShape(role));
        state.bags[i] = { ...state.bags[i], slug: encodeCustom({ shape: shape.id, cm: shape.cm }) };
        draw();
      });
    }
    for (const b of root.querySelectorAll('[data-uncustom]')) {
      b.addEventListener('click', () => {
        const i = +b.dataset.uncustom;
        /* Back to an EMPTY slot, not to whatever they had before. We did not
           keep the old choice, and restoring a bag they have not asked for
           since would be inventing an intention. An empty picker asks the
           question again, which is the honest state. */
        state.bags[i] = { ...state.bags[i], slug: '' };
        draw();
      });
    }

    /* CHANGING THE SHAPE RESETS THE SIZE, and that is the right call rather
       than an oversight. Someone switching "tote bag" to "small backpack" is
       telling us they described the wrong thing; keeping tote dimensions under
       a backpack label would answer a question they just withdrew. If they had
       typed their own figures they will type them again, which is cheap — and
       far cheaper than a silently wrong answer. */
    for (const sel of root.querySelectorAll('[data-shape]')) {
      sel.addEventListener('change', () => {
        const i = +sel.dataset.shape;
        const shape = shapeOf(sel.value);
        if (!shape) return;
        state.bags[i] = {
          ...state.bags[i],
          slug: encodeCustom({ shape: shape.id, cm: shape.cm }),
        };
        draw();
      });
    }

    /* ON `change`, NOT `input`. draw() rebuilds this whole panel, so redrawing
       per keystroke would tear the field out from under the person using it —
       the same reason the bag picker filters locally and only calls back on
       commit. `change` fires on blur or Enter, by which point they have
       finished the number.

       A value that will not parse leaves the state alone and the field is
       repainted from it, so a half-typed or nonsense entry cannot produce a
       verdict. U.toCm carries the unit: this is the only inbound conversion on
       the site. */
    for (const input of root.querySelectorAll('[data-dim]')) {
      input.addEventListener('change', () => {
        const i = +input.dataset.dim;
        const ax = +input.dataset.axis;
        const parsed = decodeCustom(state.bags[i]?.slug);
        const cm = U.toCm(input.value);
        if (!parsed || cm === null) {
          draw();
          return;
        }
        const next = [...parsed.cm];
        next[ax] = cm;
        state.bags[i] = {
          ...state.bags[i],
          slug: encodeCustom({ shape: parsed.shape ?? defaultShape(state.bags[i].role), cm: next }),
        };
        draw();
      });
    }

    for (const b of root.querySelectorAll('[data-role]')) {
      b.addEventListener('click', () => {
        state.bags[+b.dataset.slot].role = b.dataset.role;
        draw();
      });
    }
    for (const b of root.querySelectorAll('[data-rmbag]')) {
      b.addEventListener('click', () => {
        state.bags.splice(+b.dataset.rmbag, 1);
        draw();
      });
    }
    for (const b of root.querySelectorAll('[data-rmleg]')) {
      b.addEventListener('click', () => {
        state.legs.splice(+b.dataset.rmleg, 1);
        draw();
      });
    }
    root.querySelector('[data-addbag]').addEventListener('click', () => {
      /* An empty slot, not "the next bag we happen to have". Silently adding a
         product is the same accidental endorsement as preselecting one. */
      /* THE SECOND BAG IS ALMOST NEVER A SECOND CARRY-ON. This defaulted to
         'cabin' every time, which is how Frank ended up with two carry-ons
         without asking for either. See ui/bag-set.mjs — it is a default, not a
         rule, and a Eurowings business passenger flips it back in one click. */
      state.bags.push({ slug: '', role: defaultRoleForNew(state.bags) });
      draw();
    });
    root.querySelector('[data-addleg]').addEventListener('click', () => {
      /* Empty, for the same reason the first one is. */
      state.legs.push({ iata: '', fare: '' });
      draw();
    });
    /* Downshift, mounted imperatively rather than as an Astro island.

       An island has to exist in the server-rendered template, and these rows
       are built here from variable-length arrays — one per bag, one per leg,
       added and removed as the trip changes. Preact's own render() handles
       that; @astrojs/preact is still what configures the JSX transform.

       Rebuilding on every state change is safe ONLY because typing never
       redraws: the picker filters its own list locally and calls back once, on
       commit. If a keystroke went through draw() the input would be destroyed
       under the person using it.

       h(), not Picker({...}) — calling a component as a plain function runs
       its hooks outside a render context and throws. There is no JSX in an
       .astro script to hide that. */
    for (const mount of root.querySelectorAll('[data-bag-mount]')) {
      const i = +mount.dataset.bagMount;
      render(
        h(Picker, {
          items: BAG_ITEMS,
          value: state.bags[i].slug,
          label: bagLabel(i),
          kind: 'bag',
          index: i,
          placeholder: 'Choose the bag you own…',
        }),
        mount
      );
    }

    for (const mount of root.querySelectorAll('[data-carrier-mount]')) {
      const i = +mount.dataset.carrierMount;
      render(
        h(Picker, {
          items: CARRIER_ITEMS,
          value: state.legs[i].iata,
          label: `Airline for flight ${i + 1}`,
          kind: 'airline',
          index: i,
        }),
        mount
      );
    }

    for (const s of root.querySelectorAll('[data-leg-fare]')) {
      s.addEventListener('change', (e) => {
        state.legs[+e.target.dataset.legFare].fare = e.target.value;
        draw();
      });
    }
  }

  /* ---------- the answer ---------- */

  function explain(worst, rows) {
    const band = worst.result.band;
    const wont = rows.filter((x) => x.result.band === 'wont').length;
    const name = esc(worst.carrier.name);
    const personal = worst.result.role === 'personal';

    /* NOBODY CAN ANSWER, AND WE CAN SAY WHY. Distinct from the gap below it.
       Delta, Southwest, Qatar, Aegean, Air Serbia and three Chinese majors were
       read and found to publish no under-seat dimensions at all — because the
       real limit is the space beneath one seat on one aircraft, which varies.
       Every competitor either invents a number or shows nothing. Saying what
       the airline actually did is a better answer than both, and we only have
       it because somebody recorded the absence instead of skipping the row. */
    if (worst.result.unpublished) {
      return `<b class="font-semibold text-ink">${name}</b> publishes no size for the personal item — it just has to fit under the seat in front of you, and that space varies by aircraft. Nobody can give you a number here honestly, so we will not invent one.`;
    }
    if (band === null || worst.result.unknown) {
      return `We cannot answer for <b class="font-semibold text-ink">${name}</b> yet — nobody has read their baggage page. Until someone does, this trip has no honest answer.`;
    }
    if (worst.result.no_personal_item) {
      return `<b class="font-semibold text-ink">${name}</b> on leg ${worst.i + 1} includes no personal item on this fare, at any size.`;
    }
    if (worst.result.no_cabin_bag) {
      /* THE FARE TRAP, and the reason roles exist. On Ryanair Basic every
         suitcase ever made fails equally, so "Over" tells the reader nothing.
         What they need is the other half: the fare still grants a personal
         item, and something they own probably fits it. */
      const p = worst.carrier.allowances?.personal;
      return `<b class="font-semibold text-ink">${name}</b> on leg ${worst.i + 1} includes no cabin bag at all on this fare, whatever its size.${
        p
          ? ` You do still get a personal item — switch this bag to <b class="font-semibold text-ink">Personal item</b> above, or add the bag you would put under the seat.`
          : ''
      }`;
    }
    const over = `${esc(U.len(Math.abs(worst.result.delta_cm)))} ${esc(U.lenLabel())}`;
    if (band === 'wont') {
      return `<b class="font-semibold text-ink">${name} on leg ${worst.i + 1}</b> is the one that stops you — ${over} too ${esc(worst.result.dimension)}. ${
        wont > 1
          ? `${wont} of your ${rows.length} flights would turn this bag away.`
          : 'The rest of the trip would be fine.'
      }`;
    }
    if (band === 'gamble') {
      return `Over the limit on <b class="font-semibold text-ink">${name}</b>, but that is an airline that rarely measures. Everything else on this trip is clear.`;
    }
    if (band === 'line') {
      return `It clears every flight, but only just — <b class="font-semibold text-ink">${over} to spare</b> on ${name}. Pack it thin.`;
    }
    return `Clear ${personal ? 'under the seat ' : ''}on all ${rows.length} flight${rows.length > 1 ? 's' : ''}, with room on every one.`;
  }

  function legRow(x, worst) {
    const band = x.result.band;
    const bind = x === worst && (band === 'wont' || band === null);
    const delta = x.result.delta_cm;
    const detail =
      /* THREE WAYS TO HAVE NO ANSWER, and they are not interchangeable.
         "they publish no size" is a fact about the airline; "not researched
         yet" is a fact about us. Printing the same words for both would hide
         our best work behind our worst. */
      x.result.unpublished
        ? 'no size published'
        : band === null || x.result.unknown
          ? 'not researched yet'
          : x.result.no_cabin_bag
            ? 'no cabin bag on this fare'
            : x.result.no_personal_item
              ? 'no personal item on this fare'
              : delta > 0
                ? `${esc(U.len(delta))} ${esc(U.lenLabel())} too ${esc(x.result.dimension)}`
                : `${esc(U.lenText(Math.abs(delta)))} to spare`;
    const weight = x.result.advisories.find((a) => a.id === 'weight');
    return `<div class="grid grid-cols-[1.75rem_1fr_8.75rem_6.75rem] items-center gap-3 border-b border-rule px-4 py-3 last:border-b-0${
      bind ? ' bg-red-wash' : ''
    }">
      <span class="grid h-6 w-6 place-items-center rounded-full bg-surface-2 font-mono text-[0.8125rem] text-muted">${x.i + 1}</span>
      <span class="font-semibold">${esc(x.carrier.name)}<span class="block text-[0.875rem] font-normal text-muted">${esc(fareLabel(x.leg.fare, carrierOf(x.leg.iata)?.fare_names?.[x.leg.fare]))} · ${esc(strictScore(x.leg.iata))} · ${source(x.leg.iata)}</span></span>
      <span class="text-[0.9375rem] text-ink-2">${detail}${
        weight ? ` · ${weight.level === 'over' ? 'over on weight' : 'tight on weight'}` : ''
      }</span>
      <span class="rounded-full px-2.5 py-1 text-center text-[0.875rem] font-semibold whitespace-nowrap ${
        band ? TAG[band] : UNKNOWN_TAG
      }">${esc(resultLabel(x.result))}</span>
    </div>`;
  }

  /* ---------- how hard this airline checks ---------- */

  /* Strictness decides every verdict on this page and the reader could not see
     it. It is the whole difference between "Risky" and "Over": same bag, same
     centimetres over, different answer because of a number we never showed.

     Shown as a tier, never as "7/10" — that would imply a precision we do not
     have. And it says which kind of claim it is, because EVERY score in the
     dataset today is a type/region prior rather than researched enforcement.
     23 carriers do carry a researched claim about how they behave, and where
     one exists it is quoted instead of our adjective. */
  /* Tone follows the tier so the number reads at a glance. Status colour on
     non-interactive text, which docs/02 allows. */
  const STRICT_INK = ['text-green', 'text-amber', 'text-orange', 'text-red'];

  /* "9/10, measures every bag" — the number and the word, never one alone. */
  const strictScore = (iata) => {
    const st = carrierOf(iata)?.record?.strictness;
    const n = enforcementScore(st?.score);
    return n === null
      ? 'strictness unknown'
      : `${n}/${SCALE_MAX}, ${enforcementLabel(st.score).toLowerCase()}`;
  };

  /* ONE place on this page says how strict the airline is.

     It used to be two: a line under every flight's fare dropdown AND this
     callout beside the answer. Frank wanted it here only, and he is right for
     a reason beyond clutter — strictness is an explanation of THE ANSWER, and
     the answer is what this column is. Under the dropdown it was decoration
     next to a control it has nothing to do with.

     Everything about enforcement is therefore said here, once: the icon, the
     score, the tier word, the airline's own researched claim where we have
     one, and — where the tier leaves no room to give — what that means for
     the risk setting. riskEffect() used to carry that last sentence and named
     the airline and its behaviour a second time, three lines above a block
     that said it better. */
  function strictnessCallout(iata, carrier, role) {
    const strictness = carrierOf(iata)?.record?.strictness;
    if (!strictness) return '';
    const n = enforcementScore(strictness.score);
    const i = tierIndex(strictness.score);

    /* No "· assumed" marker here: enforcementNote() already ends a prior with
       "This is our starting assumption…", in words. A chip saying the same
       thing is the duplication this block exists to remove. */
    const note = enforcementNote(strictness);

    /* The consequence, but only when there IS one. At ceiling 0 the risk
       control genuinely cannot move the answer, and a reader who just dragged
       it needs to know that is the airline, not a broken control. */
    const noMargin =
      allowanceFor(carrier, role) && DEFAULT.config.gambleCeiling(carrier.strictness) === 0
        ? ' At this level the risk setting cannot change the answer — there is no margin to give.'
        : '';

    /* Icon, number, word. The icon carries the level by bar height, so it
       still reads in greyscale; the number differentiates within a tier —
       easyJet at 8 and Ryanair at 9 both "measure every bag" and are not the
       same airline to fly. */
    return `<div class="mt-4 flex items-start gap-2.5 rounded-chip bg-surface-2 px-4 py-3 text-[0.9375rem] leading-normal text-ink-2">
      <span class="mt-[0.1875rem]">${strictnessIcon(strictness.score, { size: 17 })}</span>
      <span class="min-w-0">
        <b class="font-semibold text-ink">${esc(carrier?.name ?? carrierOf(iata)?.name ?? '')} — strictness
          <span class="font-mono ${i >= 0 ? (STRICT_INK[i] ?? 'text-muted') : 'text-muted'}">${n === null ? 'unknown' : `${n}/${SCALE_MAX}`}</span>${
            n === null ? '' : `, ${esc(enforcementLabel(strictness.score).toLowerCase())}`
          }.</b>
        ${esc(note)}${noMargin}
      </span>
    </div>`;
  }

  /* ---------- provenance ---------- */

  /* Whenever this page NAMES an airline as the reason for an answer, it has to
     hand the reader the page that answer came from. "Set by Ryanair — the
     tightest limit on your itinerary" is a claim about a company, and a claim
     nobody can check is exactly what this site exists not to publish.

     Two states, and the second one matters more:

       - we have read their page: link it, dated.
       - we have NOT: say so, in place of the link. 22 of the 58 carriers here
         are still placeholder records — Ryanair, Lufthansa, American, Delta,
         British Airways among them — and they produce verdicts today. Quietly
         dropping the link on exactly those records would leave our weakest
         numbers wearing the same confident sentence as our best ones. */
  function source(iata) {
    const rec = carrierOf(iata)?.record;
    if (rec?.source_url) {
      const when = rec.verified_at
        ? ` · read ${new Date(rec.verified_at).toLocaleDateString('en-GB', { day: 'numeric', month: 'short', year: 'numeric' })}`
        : '';
      return `<a href="${esc(rec.source_url)}" rel="nofollow noopener noreferrer" target="_blank" class="text-blue hover:text-blue-hover hover:underline underline-offset-2">baggage policy ↗</a><span class="text-muted">${esc(when)}</span>`;
    }
    return `<span class="text-muted">no source recorded — this airline's page has not been read yet</span>`;
  }

  /* ---------- what the risk setting is actually doing ---------- */

  /* You asked whether Balanced and "I'll chance it" differ at all, because the
     answer never seemed to move. Measured across the catalogue: they give a
     different verdict in 2.7% of cases, and NEVER on a carrier scored 8 or
     above — because gambleCeiling returns 0 there and 0 x 1.5 is still 0.

     Those are Ryanair, Wizz, easyJet, Frontier and Vueling: precisely the
     airlines a traveller would want to chance. The arithmetic is defensible —
     they gauge every bag, and inventing slack there is the over-generous
     failure this project exists to avoid — but a control that silently does
     nothing on the cases you most want it for is a control that lies.

     So the answer now says what the setting did, including when it did
     nothing and why. */
  function riskEffect(bag, carrier, band, role) {
    if (!allowanceFor(carrier, role) || band === null) return '';
    const others = Object.entries(ENGINES)
      .filter(([id]) => id !== state.risk)
      .map(([id, E]) => [id, E.evaluate(bag, carrier, { role }).band]);

    const differing = others.filter(([, b]) => b !== band);
    const label = { strict: 'Strict', balanced: 'Balanced', chance: "I'll chance it" };

    if (differing.length) {
      return `On ${differing
        .map(([id, b]) => `<b class="font-semibold text-ink">${esc(label[id])}</b> this reads &ldquo;${esc(bandLabel(b))}&rdquo;`)
        .join(', and on ')}.`;
    }

    /* No difference. Say WHY, because "nothing changed" from a control the
       reader just moved reads as broken.

       At ceiling 0 the reason is the airline's strictness, and the callout
       directly below owns that — it names the carrier, gives the score, and
       ends with what it means for this control. Repeating it here named
       Ryanair twice and stated its enforcement three times in four lines. */
    if (DEFAULT.config.gambleCeiling(carrier.strictness) === 0) {
      return 'All three settings agree here.';
    }
    return 'All three settings agree here, so this answer does not depend on how much risk you are willing to take.';
  }

  /* ---------- the comparator ---------- */

  /* Your bag drawn against the box that decides the trip.

     Everything above this is words and numbers, and a size problem is neither
     — it is a shape sticking out of a frame. This draws that.

     Three things keep it honest, and all three are the reason it is built from
     the engine's own arrays rather than from the published dimensions:

     1. SORTED, NOT NAMED. The engine compares largest-to-largest because a bag
        rotates; "height" is the manufacturer's convention, not a constraint.
        So the axes are labelled longest / second / shortest, and the drawing
        cannot imply an orientation the verdict never assumed.
     2. EFFECTIVE, NOT PUBLISHED. A soft bag gets SOFT_COMPRESS_CM off its
        smallest side before the verdict is decided. Draw the published figure
        and the picture contradicts the answer beside it — a bag shown poking
        out of the box under the word "Fits". The caption says when this has
        happened rather than quietly redrawing the bag smaller.
     3. ONE SOURCE. `E.effective(bag)` and `desc(allowance)` are literally the
        two arrays `delta()` subtracts. The picture cannot disagree with the
        verdict, because it is the same subtraction. */
  const AXIS = ['Longest side', 'Second side', 'Shortest side'];

  function comparator(bagRecord, engineBag, carrier, band, role) {
    /* Drawn against the allowance for THIS ROLE. Reading carrier.allowance here
       regardless of role would put a bag inside the overhead box under a
       verdict computed from the ten-centimetre under-seat slot — a picture
       contradicting the word beside it, which is the one failure mode a
       comparator must never have. */
    const limit = allowanceFor(carrier, role);
    if (!limit) return '';

    /* NOTHING TO DRAW AGAINST. Singapore publishes no box at all — the rule is
       the sum of the three sides — so there is no rectangle to put the bag
       inside. Drawing a plausible one would be the single most misleading
       thing on this page: a picture reads as a measurement.
       Say the rule in words instead, with the arithmetic shown, because that
       is the whole of what the airline published. */
    if (!limit.max_cm) {
      const cap = limit.linear_max_cm;
      if (typeof cap !== 'number') return '';
      const sides3 = desc(bagRecord.external_cm);
      const sum = sides3.reduce((a, v) => a + v, 0);
      const sides = sides3.map((v) => U.len(v)).join(' + ');
      return `<div class="mt-6 rounded-card border border-rule bg-surface-2 p-5 text-[0.9375rem] text-ink-2">
        <p><b class="font-semibold text-ink">${esc(carrier.name)} sets no box.</b> Their limit is on the
        three sides added together, so no amount of turning the bag helps.</p>
        <p class="mt-2 font-mono text-[0.875rem]">${sides} = <b class="font-semibold text-ink">${U.len(sum)} ${esc(U.lenLabel())}</b>
        &nbsp;against&nbsp;<b class="font-semibold text-ink">${U.len(cap)} ${esc(U.lenLabel())}</b></p>
      </div>`;
    }

    const E = ENGINES[state.risk] ?? ENGINES.balanced;
    const bag = E.effective(engineBag);
    const box = desc(limit.max_cm);

    /* Front elevation uses the two largest axes; the third gets its own bar,
       because a flat drawing that pretends to show depth is a lie with a
       vanishing point. */
    /* Two elevations, on shared axes — the drawing convention for a box.

       Both rectangles are anchored to a common origin and measured along
       labelled axes, so the drawing reads as a measurement rather than a
       picture. Without axes the shapes are just shapes and the reader has to
       infer that they share a corner, which is the only reason the comparison
       means anything.

       FRONT elevation (left): longest side up, second side across.
       SIDE  elevation (right): the same longest side, depth across.

       The third axis used to appear only in the bars underneath, which meant
       the picture showed two thirds of the problem. A bag is stopped on
       whichever axis is worst, and depth is very often the one — an expander,
       a bulging front pocket, a hard shell that will not squeeze. The two
       panels share a baseline and a vertical scale, so the depth panel is a
       true side view rather than a second unrelated chart. */
    const H = 250;
    const OX = 52; // origin x — room for the y-axis tick labels
    const OY = H - 48; // origin y — room for the x-axis labels
    const TOP = 26; // headroom for the y arrowhead
    const PANEL_GAP = 34; // between the two elevations
    const ARROW = 22; // headroom past each x arrowhead

    /* Scaled to the LARGER of bag and limit on every axis, so an oversize bag
       overflows the dashed box visibly instead of being clipped out of frame —
       the overflow IS the finding. */
    const spanY = Math.max(bag[0], box[0]);
    const spanX = Math.max(bag[1], box[1]);
    const spanZ = Math.max(bag[2], box[2]);

    /* One scale for everything. Two panels at different scales would be a
       chart that looks like a drawing, which is worse than either. */
    const MAX_W = 460;
    const k = Math.min(
      (OY - TOP) / spanY,
      (MAX_W - OX - PANEL_GAP - ARROW * 2) / (spanX + spanZ)
    );

    /* Where the side elevation starts. */
    const DX = OX + spanX * k + ARROW + PANEL_GAP;
    const W = DX + spanZ * k + ARROW + 8;
    const RIGHT = OX + spanX * k + ARROW;
    const D_RIGHT = DX + spanZ * k + ARROW;

    const rect = (originX, long, across, attrs) =>
      `<rect x="${originX}" y="${OY - long * k}" width="${across * k}" height="${long * k}" rx="3" ${attrs}/>`;

    const stroke = band ? INK[band] : 'var(--color-muted)';

    /* A tick and its value on one axis. `originX` lets the same helper serve
       both elevations.

       `shift` moves the label clear when the two ticks nearly coincide. That is
       not an edge case: a bag 0.1 cm off the limit is the most interesting
       result this page produces, and it is exactly when the two numbers land on
       top of each other and become unreadable. */
    const tick = (axis, cm, colour, shift = 0, originX = OX) => {
      const at = cm * k;
      return axis === 'y'
        ? `<line x1="${OX - 4}" y1="${OY - at}" x2="${OX}" y2="${OY - at}" stroke="${colour}" stroke-width="1.5"/>
           <text x="${OX - 7}" y="${OY - at + 3.5 + shift}" text-anchor="end" font-size="10.5" font-family="IBM Plex Mono" fill="${colour}">${esc(U.len(cm))}</text>`
        : `<line x1="${originX + at}" y1="${OY}" x2="${originX + at}" y2="${OY + 4}" stroke="${colour}" stroke-width="1.5"/>
           <text x="${originX + at + shift}" y="${OY + 15}" text-anchor="middle" font-size="10.5" font-family="IBM Plex Mono" fill="${colour}">${esc(U.len(cm))}</text>`;
    };

    const nudge = (a, b, away) => (Math.abs(a - b) * k < 13 ? away : 0);

    const bar = (i) => {
      const over = +(bag[i] - box[i]).toFixed(1);
      const widest = Math.max(bag[i], box[i]);
      const pct = (v) => `${(v / widest) * 100}%`;
      return `<div class="grid grid-cols-[7.5rem_1fr_5.5rem] items-center gap-3 py-2">
        <span class="text-[0.875rem] text-muted">${AXIS[i]}</span>
        <span class="relative block h-6">
          <span class="absolute inset-y-0 left-0 rounded-sm bg-surface-2" style="width:${pct(box[i])}"></span>
          <span class="absolute inset-y-1 left-0 rounded-sm" style="width:${pct(bag[i])};background:${stroke};opacity:.55"></span>
          <span class="absolute inset-y-0 w-px bg-ink-2" style="left:${pct(box[i])}"></span>
        </span>
        <span class="text-right font-mono text-[0.8125rem] ${over > 0 ? 'text-red' : 'text-ink-2'}">${
          over > 0 ? `+${esc(U.len(over))}` : esc(U.len(Math.abs(over)))
        } ${esc(U.lenLabel())}</span>
      </div>`;
    };

    return `<div class="mt-6 rounded-card border border-rule bg-surface-2 p-5">
      <p class="text-[0.875rem] font-semibold text-ink">Your bag against ${esc(carrier.name)}'s ${
        role === 'personal' ? 'under-seat' : 'cabin'
      } limit</p>
      <p class="mt-0.5 text-[0.8125rem]">${source(carrier.iata)}</p>
      <div class="mt-3 flex flex-wrap items-center gap-6">
        <svg viewBox="0 0 ${W} ${H}" class="h-[250px] w-full max-w-[460px] shrink-0" role="img"
          aria-label="Two elevations of the bag drawn to scale against the airline's allowance. Left: longest side against second-longest. Right: the same longest side against the depth. Both measured from a shared baseline.">
          <defs>
            <marker id="sizer-arrow" viewBox="0 0 8 8" refX="7" refY="4" markerWidth="6" markerHeight="6" orient="auto-start-reverse">
              <path d="M0 0 L8 4 L0 8 z" fill="var(--color-ink-2)"/>
            </marker>
          </defs>

          ${rect(OX, box[0], box[1], 'fill="var(--color-surface)" stroke="var(--color-rule-strong)" stroke-width="2" stroke-dasharray="6 4"')}
          ${rect(OX, bag[0], bag[1], `fill="${stroke}" fill-opacity=".14" stroke="${stroke}" stroke-width="2.5"`)}

          ${rect(DX, box[0], box[2], 'fill="var(--color-surface)" stroke="var(--color-rule-strong)" stroke-width="2" stroke-dasharray="6 4"')}
          ${rect(DX, bag[0], bag[2], `fill="${stroke}" fill-opacity=".14" stroke="${stroke}" stroke-width="2.5"`)}

          <line x1="${OX}" y1="${OY}" x2="${OX}" y2="${TOP}" stroke="var(--color-ink-2)" stroke-width="1.5" marker-end="url(#sizer-arrow)"/>
          <line x1="${OX}" y1="${OY}" x2="${RIGHT}" y2="${OY}" stroke="var(--color-ink-2)" stroke-width="1.5" marker-end="url(#sizer-arrow)"/>
          <line x1="${DX}" y1="${OY}" x2="${DX}" y2="${TOP}" stroke="var(--color-ink-2)" stroke-width="1.5" stroke-opacity=".45"/>
          <line x1="${DX}" y1="${OY}" x2="${D_RIGHT}" y2="${OY}" stroke="var(--color-ink-2)" stroke-width="1.5" marker-end="url(#sizer-arrow)"/>

          ${tick('y', box[0], 'var(--color-rule-strong)')}
          ${tick('y', bag[0], stroke, nudge(bag[0], box[0], bag[0] > box[0] ? -11 : 11))}
          ${tick('x', box[1], 'var(--color-rule-strong)')}
          ${tick('x', bag[1], stroke, nudge(bag[1], box[1], bag[1] > box[1] ? 15 : -15))}
          ${tick('x', box[2], 'var(--color-rule-strong)', 0, DX)}
          ${tick('x', bag[2], stroke, nudge(bag[2], box[2], bag[2] > box[2] ? 15 : -15), DX)}

          <text x="14" y="${(OY + TOP) / 2}" font-size="11" font-family="Figtree" fill="var(--color-muted)"
            text-anchor="middle" transform="rotate(-90 14 ${(OY + TOP) / 2})">longest side (${esc(U.lenLabel())})</text>
          <text x="${(OX + RIGHT) / 2}" y="${H - 8}" text-anchor="middle" font-size="11" font-family="Figtree" fill="var(--color-muted)">second side</text>
          <text x="${(DX + D_RIGHT) / 2}" y="${H - 8}" text-anchor="middle" font-size="11" font-family="Figtree" fill="var(--color-muted)">depth</text>
          <text x="${OX}" y="${TOP - 9}" font-size="11.5" font-weight="600" font-family="Figtree" fill="var(--color-ink-2)">front</text>
          <text x="${DX}" y="${TOP - 9}" font-size="11.5" font-weight="600" font-family="Figtree" fill="var(--color-ink-2)">side</text>
        </svg>
        <div class="min-w-[19rem] flex-1">
          ${[0, 1, 2].map(bar).join('')}
        </div>
      </div>
      <p class="mt-2 text-[0.8125rem] text-muted">
        Compared longest side to longest side — a bag turns, so the
        manufacturer's labels for its sides are not a constraint.${
          bagRecord.soft
            ? ` Drawn ${esc(U.len(DEFAULT.config.SOFT_COMPRESS_CM))} ${esc(U.lenLabel())} thinner on the shortest side than published, because a soft bag compresses and the verdict already allows for it.`
            : ''
        }
      </p>
    </div>`;
  }

  /* ---------- bags that would work instead ---------- */

  /* THE GRID HAD NO LABEL, NO LIMIT, AND NO DESTINATION.

     Frank: "it seems like it wasn't really thought out, you can't click on
     them, it's not clear if they are filtered by bags that would actually fit."

     All three were true, and the second was the tell. The cards sat directly
     under a heading about DIMENSIONS — "the biggest bag that works on this
     whole trip" — so nothing on screen said what the cards below it were. A
     reader could reasonably have read them as the catalogue, as a promotion, or
     as bags that do NOT fit. They were in fact a filtered set, and a filter
     whose existence you cannot see is indistinguishable from no filter at all.

     So: its own heading naming the set, a count, the sort order stated, a cap,
     and every card a link. A bag card that is not a link is a dead end on a
     site where every other bag card leads to that bag's page — and here it is
     worse than a dead end, because a reader who wants to know which of the two
     Away Carry-Ons this is has nowhere to go and find out.

     SIX, then a way to see the rest. Forty-three cards is not a shortlist, it
     is the catalogue with extra steps, and it buried the copy-link row under a
     screen and a half of scrolling. */
  function bagList(fits, heldBack, personal) {
    if (!fits.length) {
      return `<p class="mt-2.5 max-w-[58ch] text-[1.03125rem] text-red">No bag we can recommend clears every leg of this trip.${
        personal
          ? ' Under-seat space is the tightest allowance any airline sells, and we hold few bags built for it — a soft tote or a laptop sleeve is what gets through.'
          : ' On a trip this tight you are looking at an under-seat bag, or checking one.'
      }${
        heldBack
          ? ` ${heldBack} would fit on ${heldBack > 1 ? 'their' : 'its'} published figures, but ${heldBack > 1 ? 'those figures are' : 'that figure is'} not the manufacturer's own, so we will not put ${heldBack > 1 ? 'them' : 'it'} forward.`
          : ''
      }</p>`;
    }

    const card = (x) =>
      /* Linked, like every other bag card on the site. Also how a reader tells
         the aluminium Away Carry-On from the polycarbonate one, which share a
         brand and a model name and differ by six millimetres. */
      `<a href="/bags/${esc(x.slug)}/"
         class="flex flex-col gap-1.5 rounded-card border border-rule bg-surface p-4 no-underline hover:border-blue">
         <span class="text-base font-semibold leading-tight text-ink">${esc(x.brand)} ${esc(x.model)}</span>
         <span class="font-mono text-[0.84375rem] text-muted">${esc(U.dims(x.external_cm))}</span>
       </a>`;

    return `<div class="mt-5 border-t border-blue/20 pt-4">
      <p class="text-[0.875rem] font-semibold text-ink">
        ${fits.length === 1 ? 'One bag we hold' : `${fits.length} bags we hold`} ${
          fits.length === 1 ? 'clears' : 'clear'
        } every leg${fits.length > SHOWN ? `, roomiest ${SHOWN} first` : ''}
      </p>
      <p class="mt-0.5 max-w-[58ch] text-[0.8125rem] text-muted">
        Checked the same way as the answer above, on each airline's own limit${
          heldBack
            ? `. ${heldBack} more would fit, held back because ${heldBack > 1 ? 'their figures are' : 'its figure is'} not the manufacturer's own`
            : ''
        }.
      </p>
      <div class="mt-3.5 grid gap-3.5 [grid-template-columns:repeat(auto-fill,minmax(13rem,1fr))]">
        ${fits.slice(0, SHOWN).map(card).join('')}
      </div>
      ${
        fits.length > SHOWN
          ? `<p class="mt-3.5 text-[0.875rem]"><a href="/bags/" class="text-blue hover:text-blue-hover hover:underline underline-offset-2">Browse all ${fits.length} &rarr;</a></p>`
          : ''
      }
    </div>`;
  }

  /* Its own function rather than a ternary inside the answer template. The
     first version nested a `barred ? … : …` around an existing `env ? … : …`
     and the indentation stopped describing the structure — correct code that
     nobody, including me a week from now, could read to check. */
  function envelopePanel({ barred, env, setters, fits, heldBack, personal }) {
    const item = personal ? 'personal item' : 'cabin bag';

    /* NO SIZE ANSWERS THIS. A fare including no cabin bag is not a tight limit,
       it is the absence of one, and an envelope is the wrong shape of answer
       entirely. Names the leg and gives the actual remedy, because buying up a
       fare or checking the bag is something the reader can act on today —
       whereas a list of bags is a way through that does not exist. */
    const inner = barred.length
      ? `<p class="text-[0.875rem] font-semibold text-red">There is no size that works on this trip</p>
         <p class="mt-1.5 max-w-[58ch] text-[1.03125rem] text-ink-2">
           <b class="font-semibold text-ink">${esc(
             barred
               .map(
                 (x) =>
                   `${x.carrier.name} (${fareLabel(x.leg.fare, carrierOf(x.leg.iata)?.fare_names?.[x.leg.fare])})`
               )
               .join(' and ')
           )}</b>
           ${barred.length > 1 ? 'include' : 'includes'} no ${item} at any size, so no bag we could
           suggest would get through. Buying up a fare class, or checking the bag, is what changes that.
         </p>
         <p class="mt-1.5 text-[0.8125rem]">Check it yourself: ${barred.map((x) => source(x.leg.iata)).join(' · ')}</p>`
      : env
        ? `<p class="text-[0.875rem] font-semibold text-blue">The biggest ${
            personal ? 'personal item' : 'bag'
          } that works on this whole trip</p>
           <p class="mt-1.5 text-[clamp(1.9rem,4.6vw,2.7rem)] font-bold leading-none tracking-tight tabular-nums">${env
             .map((v) => esc(U.len(v)))
             .join(
               '<span class="px-1.5 text-[0.66em] text-muted">×</span>'
             )}<span class="ml-1.5 text-[0.42em] font-normal text-muted">${esc(U.lenLabel())}</span></p>
           <p class="mt-2.5 max-w-[58ch] text-[1.03125rem] text-ink-2">Set by <b class="font-semibold text-ink">${esc(
             setters.map((x) => x.name).join(' and ')
           )}</b> — the tightest limit on your itinerary. This is a size comparison only: fare entitlement, packed weight and the aircraft's own bins still need checking.</p>
           <p class="mt-1.5 text-[0.8125rem]">Check it yourself: ${setters.map((x) => source(x.iata)).join(' · ')}</p>
           ${bagList(fits, heldBack, personal)}`
        : `<p class="text-[0.875rem] font-semibold text-blue">The biggest ${
            personal ? 'personal item' : 'bag'
          } that works on this whole trip</p>
           <p class="mt-1.5 max-w-[58ch] text-[1.03125rem] text-ink-2">We cannot draw one yet — no leg on this trip has ${
             personal ? 'a published under-seat size' : 'an allowance we have read'
           }.</p>`;

    return `<div class="mt-6 rounded-card ${
      barred.length ? 'bg-red-wash' : 'bg-blue-wash'
    } px-6 py-[1.375rem]">${inner}</div>`;
  }

  /* ONE CARD PER BAG, and it took a bug report to notice there was only ever
     one.

     Frank: "if I add more than a single piece of luggage the right side panel
     does not evaluate both only the first one."

     renderAnswer() opened with `state.bags.find(x => x.slug)` and everything
     below it described that bag. The others got a verdict chip in the left
     column and nothing else — so adding a personal item beside your carry-on
     made the carry-on's answer vanish.

     That was defensible exactly once: when bags were ALTERNATIVES. The add
     button still says "add another bag to compare", and comparing two rollers
     one at a time is a coherent thing to build. Roles broke that assumption
     without anyone updating this function — a carry-on and a personal item are
     not alternatives, they are a set you carry at the same time, which is the
     whole premise of docs/27.

     WHAT THIS STILL DOES NOT ANSWER, and the limitation is worth naming
     rather than leaving to be discovered: whether the two bags work TOGETHER.
     Piece counts, and the shared cabin weight cap that Air France, KLM,
     Cathay, JAL, ANA and Scoot apply across both bags at once, are set-level
     facts and no stack of per-bag cards can express them. That is docs/27
     phase 4. This fixes the disappearing bag; it does not fix the set. */
  function answerCard(slot) {
    const { rows, worst, bag: bagOfEngine, role } = score(slot);
    const b = bagOf(slot.slug);
    const band = worst.result.band;
    const advisories = worst.result.advisories.map((a) => advisoryLine(a, U)).filter(Boolean);

    return `<div class="rounded-card border border-rule border-l-[6px] bg-surface p-[1.625rem] shadow-panel ${
      band ? EDGE[band] : 'border-l-rule-strong'
    }">
      <p class="text-[0.875rem] text-muted">${esc(b.brand)} ${esc(b.model)} · <b class="font-semibold text-ink-2">${esc(roleLabel(role))}</b> · ${esc(U.dims(b.external_cm))} · ${rows.length} flight${rows.length > 1 ? 's' : ''}</p>
      <p class="mt-1 text-[clamp(2rem,5vw,3rem)] font-bold leading-none tracking-tight ${
        band ? WORD[band] : 'text-muted'
      }">${esc(resultLabel(worst.result))}</p>
      <p class="mt-3 max-w-[56ch] text-lg text-ink-2">${explain(worst, rows)}</p>
      <p class="mt-2 max-w-[56ch] text-[0.9375rem] text-muted">
        Answered on <b class="font-semibold text-ink">${esc(RISK_LABEL[state.risk])}</b>.
        ${riskEffect(bagOfEngine, worst.carrier, band, role)}
      </p>

      ${strictnessCallout(worst.leg.iata, worst.carrier, role)}

      ${comparator(b, bagOfEngine, worst.carrier, band, role)}

      <div class="mt-6 overflow-hidden rounded-card border border-rule">
        ${rows.map((x) => legRow(x, worst)).join('')}
      </div>

      ${
        advisories.length
          ? `<ul class="mt-4 space-y-2">${advisories
              .map(
                (line) =>
                  `<li class="rounded-chip bg-surface-2 px-4 py-3 text-[0.9375rem] text-ink-2">${esc(line)}</li>`
              )
              .join('')}</ul>`
          : ''
      }
    </div>`;
  }

  /* THE FIRST SET-LEVEL FINDING THIS SITE CAN STATE.
     
     No stack of per-bag verdicts can reach it: each bag can fit its box
     perfectly and the pair still be refused, because the limit being broken is
     a COUNT rather than a size. That is docs/27's whole argument for modelling
     a kit instead of a bag, and it is why this sits ABOVE the cards rather than
     inside one — it is not true of either bag on its own.
     
     Amber, not red. The reader is not wrong about their bags; they are over on
     an allowance, and the fix is a fare or a gate check rather than a different
     suitcase. */
  function pieceNotice(over) {
    if (!over.length) return '';
    const line = (o) =>
      `<b class="font-semibold text-ink">${esc(o.carrier.name)} (${esc(
        fareLabel(o.leg.fare, carrierOf(o.leg.iata)?.fare_names?.[o.leg.fare])
      )})</b> grants ${o.granted === 1 ? 'one' : o.granted} ${
        o.role === 'personal' ? 'personal item' : 'cabin bag'
      }${o.granted === 1 ? '' : 's'}; you have ${o.carrying}`;
    return `<div class="rounded-card border border-amber/30 bg-amber-wash px-5 py-4">
      <p class="text-[0.875rem] font-semibold text-amber">More bags than the fare allows</p>
      <p class="mt-1 max-w-[58ch] text-[0.9375rem] text-ink-2">
        ${over.map(line).join('. ')}. Size is not the problem here — the extra bag has no
        allowance at all on ${over.length > 1 ? 'those legs' : 'that leg'}, whatever it measures.
      </p>
    </div>`;
  }

  /* Two empty states now, in the order the page asks its questions. Each says
     what the NEXT step buys the reader rather than merely naming it — an empty
     panel that says "choose a bag" is a label on a hole. */
  const emptyPanel = (title, body) => `
    <div class="rounded-card border border-dashed border-rule-strong bg-surface p-[1.625rem]">
      <p class="text-lg font-semibold text-ink">${title}</p>
      <p class="mt-2 max-w-[56ch] text-ink-2">${body}</p>
    </div>`;

  function renderAnswer() {
    const legs = flownLegs();
    const chosen = state.bags.filter((x) => x.slug);

    /* THE FLIGHT COMES FIRST, so its absence is the first thing to say. Nothing
       below this point is answerable without it: the fare decides whether a
       cabin bag exists at all, and asking for a bag before we know that is
       collecting input we may have to throw away. */
    if (!legs.length) {
      el('[data-answer]').innerHTML = emptyPanel(
        'Start with your flights',
        `Add every leg and the fare you booked. The fare decides more than the bag does —
         on some tickets there is no cabin bag at any size, and we can tell you that
         before you go looking for a suitcase.`
      );
      return;
    }

    if (!chosen.length) {
      el('[data-answer]').innerHTML = emptyPanel(
        'Now add your bags',
        `We check each one against every leg, name the flight that decides the trip, and
         draw the biggest bag that survives all of them.`
      );
      return;
    }

    /* THE ENVELOPE IS A FACT ABOUT THE TRIP, NOT ABOUT ONE BAG, so it moves out
       of the card and renders once per ROLE the reader is actually carrying.
       Two carry-ons would otherwise print the same box twice, and a carry-on
       plus a personal item needs both boxes — they are wildly different
       numbers and only one of them was ever shown.

       Every bag the reader already has is excluded from the suggestions, not
       just the first: offering someone back a bag they told us they own is the
       same mistake in a smaller costume. */
    const owned = chosen.map((x) => x.slug);
    const rolesInUse = [...new Set(chosen.map((x) => x.role))];
    const envelopes = rolesInUse.map((role) => {
      /* Any bag in this role will do for the ROWS. tripEnvelope reads only the
         parts of a result that describe the ticket — no cabin bag, no personal
         item, not researched — and those are facts about the carrier, the fare
         and the role, not about which bag was measured against them. Stated
         because passing "one of the reader's bags" to compute a trip-level box
         otherwise looks like a bug. */
      const sample = chosen.find((x) => x.role === role);
      return envelopePanel(
        tripEnvelope({
          rows: score(sample).rows,
          role,
          bags: DATA.bags,
          toEngineBag,
          engine: ENGINES[state.risk] ?? ENGINES.balanced,
          ownSlugs: owned,
        })
      );
    });

    /* Computed from the FIRST bag's rows — the legs and fares are the same for
       every bag on the trip, and the check is about how many bags there are,
       not which. */
    const overages = pieceOverages({ slots: chosen, rows: score(chosen[0]).rows });

    el('[data-answer]').innerHTML = `
      <div class="space-y-4">
        ${pieceNotice(overages)}
        ${chosen.map(answerCard).join('')}
        ${envelopes.join('')}
        <div class="flex flex-wrap items-center gap-3 pt-1">
          <button type="button" data-copy
            class="min-h-[2.875rem] cursor-pointer rounded-full border border-rule-strong px-[1.125rem] py-2.5 font-semibold hover:border-blue hover:text-blue">Copy link to this trip</button>
          <span class="font-mono text-[0.84375rem] break-all text-muted" data-permalink></span>
        </div>
      </div>`;

    el('[data-permalink]').textContent = permalink().replace(/^https?:\/\//, '');
    el('[data-copy]').addEventListener('click', async (e) => {
      try {
        await navigator.clipboard.writeText(permalink());
        e.target.textContent = 'Copied';
        setTimeout(() => {
          e.target.textContent = 'Copy link to this trip';
        }, 1600);
      } catch {
        /* Clipboard is permission-gated and silently unavailable in plenty of
           contexts. The URL is already on screen next to the button, so say so
           rather than failing invisibly. */
        e.target.textContent = 'Copy it from the address beside this button';
      }
    });
  }

  function draw() {
    renderInputs();
    renderAnswer();
    history.replaceState(null, '', permalink());
  }

  boot().catch((err) => {
    /* Never leave a spinner running. A tool that silently fails to load reads
       as a broken site; say what happened and offer the static route. */
    el('[data-loading]').innerHTML =
      `Could not load the catalogue (${esc(err.message)}). ` +
      `<a href="/bags/" class="text-blue hover:text-blue-hover hover:underline underline-offset-2">Browse bags instead</a>.`;
  });
</script>
