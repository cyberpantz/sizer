---
import Base from '../layouts/Base.astro';
import BagCard from '../components/BagCard.astro';
import { loadBags, loadCarriers, coverageStats } from '../lib/data.mjs';
import { shelve } from '../lib/shelves.mjs';

/* Everything here runs at build time. The engine is pure, so the same functions
   run in the browser for the interactive check — see docs/17-tech-stack.md. */
const bags = await loadBags();
const carriers = await loadCarriers();
const shelves = shelve(bags, carriers);
const stats = await coverageStats();

/* The number we can honestly stand behind: carriers the engine can actually
   answer for, not the number of files in data/carriers/. */
const answerable = carriers.filter((c) => !c.cabin_unknown).length;
---
<Base
  title="Sizer — which carry-on actually fits your flight"
  description={`Airlines measure the outside of your bag — wheels and handle included. We use the manufacturer's own overall dimensions, never a reseller listing, and check them against ${answerable} airlines.`}
>
  <div class="mx-auto max-w-page px-6">

    {/* SAY WHAT THIS IS BEFORE SAYING WHY IT IS GOOD.
        The headline used to be "The same bag, three different sets of
        dimensions" — a true and interesting thesis, and the wrong first
        sentence. A visitor landing here has one question, "am I in the right
        place", and that headline made them read four more lines to answer it.
        An insight is what you EARN attention with; a service statement is what
        you spend it on.

        So the thesis moves down to the section that argues it, and the top of
        the page names the job: does a specific bag pass a specific airline's
        gate. Everything that qualifies the answer — the manufacturer's figure,
        fare by fare, the airline count — belongs in the sentence UNDER it,
        where a reader who has already decided they are in the right place will
        look for a reason to trust us. */}
    <section class="pt-16 pb-12">
      <h1 class="max-w-3xl text-4xl font-bold leading-tight tracking-tight sm:text-5xl">
        Will your carry-on{' '}
        <span class="text-muted">actually fit?</span>
      </h1>
      <p class="mt-5 max-w-2xl text-lg text-ink-2">
        Check any bag against {answerable} airlines, fare by fare — measured the
        way a gate measures it, wheels and handle included.
      </p>

      {/* THREE DOORS, because there are three ways in and the reader arrives
          already inside one of them: they own a bag, they are buying one, or
          they have a trip booked. Naming all three is how someone recognises
          themselves without reading a paragraph first. */}
      <div class="mt-8 grid gap-3 sm:grid-cols-3">
        <a
          href="/check/"
          class="group rounded-card border border-rule bg-surface p-4 no-underline shadow-panel hover:border-blue"
        >
          <span class="block font-semibold text-ink group-hover:text-blue">I have a bag</span>
          <span class="mt-1 block text-[0.875rem] leading-snug text-muted">
            Type its size in and check it against your flights.
          </span>
        </a>
        <a
          href="/bags/"
          class="group rounded-card border border-rule bg-surface p-4 no-underline shadow-panel hover:border-blue"
        >
          <span class="block font-semibold text-ink group-hover:text-blue">I am buying one</span>
          {/* NO COUNT. It said "Browse 57 bags", and a catalogue size is a
              number that can only lose. Say it and a reader either finds it
              small — next to marketplaces listing thousands — or does not care.
              Neither reaction helps them, and the useful claim is the one after
              the comma: these are RANKED, by something no marketplace ranks by.
              Inventory is a boast; the ordering is the service.

              "fit", not "clear", and matching the /bags headline word for word.
              A door and the room behind it should say the same thing; a reader
              who follows a link labelled one way and lands on a page labelled
              another has to stop and check they arrived. */}
          <span class="mt-1 block text-[0.875rem] leading-snug text-muted">
            Bags ranked by how many airlines they fit.
          </span>
        </a>
        <a
          href="/guide/"
          class="group rounded-card border border-rule bg-surface p-4 no-underline shadow-panel hover:border-blue"
        >
          <span class="block font-semibold text-ink group-hover:text-blue">I am flying somewhere</span>
          <span class="mt-1 block text-[0.875rem] leading-snug text-muted">
            Look up one airline's limits and how strictly it enforces them.
          </span>
        </a>
      </div>
    </section>

    {/* THE THESIS, DEMOTED TO WHERE IT BELONGS. This is the reason to use
        Sizer rather than the first thing a stranger should read. */}
    <section class="border-t border-rule py-10">
      <h2 class="max-w-3xl text-2xl font-semibold tracking-tight">
        The same bag, three different sets of dimensions.
      </h2>
      <p class="mt-2 max-w-2xl text-ink-2">
        Airlines measure the outside — wheels and handle included. Resellers and
        marketplaces quote whichever figure they happened to get. We use the
        manufacturer's own overall dimensions, say so on every bag when we
        cannot, and check them against {answerable} airlines fare by fare.
      </p>
      <p class="mt-3">
        <a href="/methodology/" class="text-blue hover:text-blue-hover hover:underline underline-offset-2">How we work it out →</a>
      </p>
    </section>

    {shelves.map((shelf) => shelf.bags.length > 0 && (
      <section class="border-t border-rule py-10">
        <div class="flex flex-wrap items-baseline justify-between gap-2">
          <h2 class="text-2xl font-semibold tracking-tight">{shelf.title}</h2>
          <span class="font-mono text-[0.8125rem] text-muted">{shelf.bags.length} bags</span>
        </div>
        <p class="mt-1 max-w-2xl text-ink-2">{shelf.blurb}</p>

        <div class="mt-6 grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
          {shelf.bags.slice(0, 6).map(({ bag, coverage }) => (
            <BagCard bag={bag} coverage={coverage} />
          ))}
        </div>

        {shelf.bags.length > 6 && (
          <p class="mt-4">
            <a href="/bags/" class="text-blue hover:text-blue-hover hover:underline underline-offset-2">See all {shelf.bags.length} →</a>
          </p>
        )}
      </section>
    ))}

    {/* The release gate (docs/19): a bag may only be RECOMMENDED on the
        manufacturer's own overall figure. Most of the catalogue is still on a
        review publication's measurement, so rather than quietly promote anyway,
        the page names the split. It disappears on its own as sources improve. */}
    {stats.bags_promotable < stats.bags_sized && (
      <section class="mb-16 rounded-card border border-amber/30 bg-amber-wash p-5">
        <h2 class="font-semibold text-amber">Where these numbers come from</h2>
        <p class="mt-2 max-w-3xl text-[0.9375rem] text-ink-2">
          {/* THREE NUMBERS, NOT ONE. This said "{promotable} of {sized} carry
              the manufacturer's own overall dimensions. The rest use a review
              publication's measurement" — and "the rest" was false. Nearly
              every bag is on a maker figure; what varies is whether the maker
              SAYS which figure it is. Reporting only the strictest rung read
              as "we have almost no manufacturer data". */}
          <strong>{stats.bags_maker_sourced} of {stats.bags_sized}</strong> bags here
          use the manufacturer's own published figures. For{' '}
          <strong>{stats.bags_promotable}</strong> of them the manufacturer states
          that figure is the outside of the bag — wheels included — and only those
          are put forward as an answer. The others publish a size without
          saying which one it is, so we show them and say so.{' '}
          {stats.bags_review_only > 0 && (
            <>{stats.bags_review_only} still rest on a review publication's
            measurement, attributed on the card.</>
          )}{' '}
          We do not use reseller or marketplace listings for dimensions.
          {stats.carriers_researched < stats.carriers_total && (
            <> Of {stats.carriers_total} airlines, {stats.carriers_researched} have
            had their published allowances read from source.</>
          )}
        </p>
        <p class="mt-2 text-[0.9375rem]">
          <a href="/methodology/" class="text-blue hover:text-blue-hover hover:underline underline-offset-2">How we work it out, and what that claim is worth →</a>
        </p>
      </section>
    )}

  </div>
</Base>
