---
import Base from '../layouts/Base.astro';
import BagCard from '../components/BagCard.astro';
import { loadBags, loadCarriers, coverageStats } from '../lib/data.mjs';
import { shelve } from '../lib/shelves.mjs';

/* Everything here runs at build time. The engine is pure, so the same functions
   run in the browser for the interactive check — see docs/17-tech-stack.md. */
const bags = await loadBags();
const carriers = await loadCarriers();
const shelves = shelve(bags, carriers);
const stats = await coverageStats();

/* The number we can honestly stand behind: carriers the engine can actually
   answer for, not the number of files in data/carriers/. */
const answerable = carriers.filter((c) => !c.cabin_unknown).length;
---
<Base
  title="Sizer — which carry-on actually fits your flight"
  description={`Airlines measure the outside of your bag — wheels and handle included. We use the manufacturer's own overall dimensions, never a reseller listing, and check them against ${answerable} airlines.`}
>
  <div class="mx-auto max-w-page px-6">

    <section class="pt-16 pb-12">
      {/* Names the behaviour, not an actor — see docs/16. An earlier version
          read "Manufacturers publish the inside", which is false of Travelpro
          and Rick Steves: both publish packing AND overall, and Travelpro says
          outright which one to compare against an airline limit. The real
          problem is that the figure is reported inconsistently across the
          places people shop. */}
      <h1 class="max-w-3xl text-4xl font-bold leading-tight tracking-tight sm:text-5xl">
        The same bag, three different{' '}
        <span class="text-muted">sets of dimensions.</span>
      </h1>
      <p class="mt-5 max-w-2xl text-lg text-ink-2">
        Airlines measure the outside — wheels and handle included. Resellers
        and marketplaces quote whichever figure they happened to get. We take
        the manufacturer's own overall dimensions and check them against{' '}
        {answerable} airlines, fare by fare.
      </p>

      <div class="mt-8 flex flex-wrap gap-3">
        <a
          href="/check/"
          class="rounded-chip bg-blue px-5 py-3 font-semibold text-on-blue no-underline hover:bg-blue-hover"
        >Check a bag you own</a>
        <a
          href="/bags/"
          class="rounded-chip border border-rule-strong px-5 py-3 font-semibold text-ink no-underline hover:border-blue hover:text-blue"
        >Browse bags that fit</a>
      </div>
    </section>

    {shelves.map((shelf) => shelf.bags.length > 0 && (
      <section class="border-t border-rule py-10">
        <div class="flex flex-wrap items-baseline justify-between gap-2">
          <h2 class="text-2xl font-semibold tracking-tight">{shelf.title}</h2>
          <span class="font-mono text-[0.8125rem] text-muted">{shelf.bags.length} bags</span>
        </div>
        <p class="mt-1 max-w-2xl text-ink-2">{shelf.blurb}</p>

        <div class="mt-6 grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
          {shelf.bags.slice(0, 6).map(({ bag, coverage }) => (
            <BagCard bag={bag} coverage={coverage} />
          ))}
        </div>

        {shelf.bags.length > 6 && (
          <p class="mt-4">
            <a href="/bags/" class="text-blue">See all {shelf.bags.length} →</a>
          </p>
        )}
      </section>
    ))}

    {/* The release gate (docs/19): a bag may only be RECOMMENDED on the
        manufacturer's own overall figure. Most of the catalogue is still on a
        review publication's measurement, so rather than quietly promote anyway,
        the page names the split. It disappears on its own as sources improve. */}
    {stats.bags_promotable < stats.bags_sized && (
      <section class="mb-16 rounded-card border border-amber/30 bg-amber-wash p-5">
        <h2 class="font-semibold text-amber">Where these numbers come from</h2>
        <p class="mt-2 max-w-3xl text-[0.9375rem] text-ink-2">
          {/* THREE NUMBERS, NOT ONE. This said "{promotable} of {sized} carry
              the manufacturer's own overall dimensions. The rest use a review
              publication's measurement" — and "the rest" was false. Nearly
              every bag is on a maker figure; what varies is whether the maker
              SAYS which figure it is. Reporting only the strictest rung read
              as "we have almost no manufacturer data". */}
          <strong>{stats.bags_maker_sourced} of {stats.bags_sized}</strong> bags here
          use the manufacturer's own published figures. For{' '}
          <strong>{stats.bags_promotable}</strong> of them the maker states that
          figure is the outside of the bag — wheels included — and only those
          are put forward as an answer. The others publish a size without
          saying which one it is, so we show them and say so.{' '}
          {stats.bags_review_only > 0 && (
            <>{stats.bags_review_only} still rest on a review publication's
            measurement, attributed on the card.</>
          )}{' '}
          We do not use reseller or marketplace listings for dimensions.
          {stats.carriers_researched < stats.carriers_total && (
            <> Of {stats.carriers_total} airlines, {stats.carriers_researched} have
            had their published allowances read from source.</>
          )}
        </p>
        <p class="mt-2 text-[0.9375rem]">
          <a href="/methodology/" class="text-blue">How we work it out, and what that claim is worth →</a>
        </p>
      </section>
    )}

  </div>
</Base>
