---
import Base from '../layouts/Base.astro';
import BagCard from '../components/BagCard.astro';
import { loadBags, loadCarriers, coverageStats } from '../lib/data.mjs';
import { DIM_SOURCE } from '../engine/normalize.mjs';
import { shelve } from '../lib/shelves.mjs';

/* Everything here runs at build time. The engine is pure, so the same functions
   run in the browser for the interactive check — see docs/17-tech-stack.md. */
const bags = await loadBags();
const carriers = await loadCarriers();
const shelves = shelve(bags, carriers);
const stats = await coverageStats();

/* The number we can honestly stand behind: carriers the engine can actually
   answer for, not the number of files in data/carriers/. */
const answerable = carriers.filter((c) => !c.cabin_unknown).length;

/* PROVENANCE, COUNTED IN RUNGS THAT PARTITION THE CATALOGUE.
 *
 * Over `bags` — the bags a reader can actually open — rather than over
 * coverageStats, which counts every record on disk including roles this page
 * does not list. Mixing the two is what let the callout say "61 of 61" in one
 * clause and "12 rest on a review" in the next.
 *
 * Every published bag sits on exactly one rung, so these three sum to
 * bags.length and a reader can check the arithmetic. */
const rung = (name) => bags.filter((b) => b.dim_source === name).length;
const onOverall = rung(DIM_SOURCE.MAKER_OVERALL) + rung(DIM_SOURCE.MEASURED);
const onUnlabelled = rung(DIM_SOURCE.MAKER_UNSPECIFIED) + rung(DIM_SOURCE.MAKER_PACKING);
const onReview = rung(DIM_SOURCE.REVIEW);
---
<Base
  title="Sizer — which carry-on actually fits your flight"
  description={`Airlines measure the outside of your bag — wheels and handle included. We use the manufacturer's own overall dimensions, never a reseller listing, and check them against ${answerable} airlines.`}
>
  <div class="mx-auto max-w-page px-6">

    {/* SAY WHAT THIS IS BEFORE SAYING WHY IT IS GOOD.
        The headline used to be "The same bag, three different sets of
        dimensions" — a true and interesting thesis, and the wrong first
        sentence. A visitor landing here has one question, "am I in the right
        place", and that headline made them read four more lines to answer it.
        An insight is what you EARN attention with; a service statement is what
        you spend it on.

        So the thesis moves down to the section that argues it, and the top of
        the page names the job: does a specific bag pass a specific airline's
        gate. Everything that qualifies the answer — the manufacturer's figure,
        fare by fare, the airline count — belongs in the sentence UNDER it,
        where a reader who has already decided they are in the right place will
        look for a reason to trust us. */}
    <section class="pt-16 pb-12">
      <h1 class="max-w-3xl text-4xl font-bold leading-tight tracking-tight sm:text-5xl">
        Will your carry-on{' '}
        <span class="text-muted">actually fit?</span>
      </h1>
      <p class="mt-5 max-w-2xl text-lg text-ink-2">
        Check any bag against {answerable} airlines, fare by fare — measured the
        way airlines measure them, wheels and handle included.
      </p>

      {/* THREE DOORS, because there are three ways in and the reader arrives
          already inside one of them: they own a bag, they are buying one, or
          they have a trip booked. Naming all three is how someone recognises
          themselves without reading a paragraph first. */}
      <div class="mt-8 grid gap-3 sm:grid-cols-3">
        <a
          href="/check/"
          class="group rounded-card border border-rule bg-surface p-4 no-underline shadow-panel hover:border-blue"
        >
          <span class="block font-semibold text-ink group-hover:text-blue">I have a bag</span>
          <span class="mt-1 block text-[0.875rem] leading-snug text-muted">
            Type its size in and check it against your flights.
          </span>
        </a>
        <a
          href="/bags/"
          class="group rounded-card border border-rule bg-surface p-4 no-underline shadow-panel hover:border-blue"
        >
          <span class="block font-semibold text-ink group-hover:text-blue">I am buying one</span>
          {/* NO COUNT. It said "Browse 57 bags", and a catalogue size is a
              number that can only lose. Say it and a reader either finds it
              small — next to marketplaces listing thousands — or does not care.
              Neither reaction helps them, and the useful claim is the one after
              the comma: these are RANKED, by something no marketplace ranks by.
              Inventory is a boast; the ordering is the service.

              "fit", not "clear", and matching the /bags headline word for word.
              A door and the room behind it should say the same thing; a reader
              who follows a link labelled one way and lands on a page labelled
              another has to stop and check they arrived. */}
          <span class="mt-1 block text-[0.875rem] leading-snug text-muted">
            Bags ranked by how many airlines they can fly on.
          </span>
        </a>
        {/* THIS DOOR OPENED A READING PAGE WHILE THE OTHER TWO OPENED TOOLS.
            Frank: "the first two land a user in a place they expect, the third
            lands them on the guide."

            docs/15-sitemap.md already settled it — "the three doors are not nav
            items, they're modes of /check" — so pointing at /guide was a
            deviation rather than a gap. It became the wrong link the moment
            /check was reordered to ask for flights first: the airline-first
            mode this card describes is now literally how that page opens.

            NOT an airline page. docs/10 concedes the policy lookup outright:
            "ryanair carry on size" is unwinnable against Ryanair, who publish
            it themselves. The airline is a qualifier on a bag question, never
            the subject. /luggage-for/[carrier] is where that intent goes when
            it ships; the guide stays linked from the thesis section below,
            which is where someone reading rather than checking will find it. */}
        <a
          href="/check/"
          class="group rounded-card border border-rule bg-surface p-4 no-underline shadow-panel hover:border-blue"
        >
          <span class="block font-semibold text-ink group-hover:text-blue">I am flying somewhere</span>
          <span class="mt-1 block text-[0.875rem] leading-snug text-muted">
            Add your flights and see what each one allows.
          </span>
        </a>
      </div>
    </section>

    {/* THE THESIS, DEMOTED TO WHERE IT BELONGS. This is the reason to use
        Sizer rather than the first thing a stranger should read. */}
    <section class="border-t border-rule py-10">
      <h2 class="max-w-3xl text-2xl font-semibold tracking-tight">
        The same bag, three different sets of dimensions.
      </h2>
      <p class="mt-2 max-w-2xl text-ink-2">
        Airlines measure the outside — wheels and handle included. Resellers and
        marketplaces quote whichever figure they happened to get. We use the
        manufacturer's own overall dimensions on every bag re reccomend.
      </p>
      {/* The guide's contextual home, now that it is no longer one of the three
          doors. docs/15: reference pages are "linked contextually — that's where
          someone actually wants them". Beside the thesis is where a reader who
          is reading rather than checking has just arrived. */}
      <p class="mt-3 flex flex-wrap gap-x-6 gap-y-1">
        <a href="/methodology/" class="text-blue hover:text-blue-hover hover:underline underline-offset-2">Our Hmethodology →→</a>
        <a href="/guide/" class="text-blue hover:text-blue-hover hover:underline underline-offset-2">The carry-on guide →</a>
      </p>
    </section>

    {shelves.map((shelf) => shelf.bags.length > 0 && (
      <section class="border-t border-rule py-10">
        <div class="flex flex-wrap items-baseline justify-between gap-2">
          <h2 class="text-2xl font-semibold tracking-tight">{shelf.title}</h2>
          <span class="font-mono text-[0.8125rem] text-muted">{shelf.bags.length} bags</span>
        </div>
        <p class="mt-1 max-w-2xl text-ink-2">{shelf.blurb}</p>

        <div class="mt-6 grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
          {shelf.bags.slice(0, 6).map(({ bag, coverage }) => (
            <BagCard bag={bag} coverage={coverage} />
          ))}
        </div>

        {shelf.bags.length > 6 && (
          <p class="mt-4">
            <a href="/bags/" class="text-blue hover:text-blue-hover hover:underline underline-offset-2">See all {shelf.bags.length} →</a>
          </p>
        )}
      </section>
    ))}

    {/* The release gate (docs/19): a bag may only be RECOMMENDED on the
        manufacturer's own overall figure. Most of the catalogue is still on a
        review publication's measurement, so rather than quietly promote anyway,
        the page names the split. It disappears on its own as sources improve. */}
    {stats.bags_promotable < stats.bags_sized && (
      <section class="mb-16 rounded-card border border-amber/30 bg-amber-wash p-5">
        <h2 class="font-semibold text-amber">Where these numbers come from</h2>
        {/* A TABLE, BECAUSE THIS IS A PARTITION AND PROSE HID THAT.
            Frank: "formatted as a paragraph is hard to scan and seems less
            trustworthy." Both halves are right, and the second follows from
            the first — three counts of one catalogue asks to be checked, and a
            reader cannot check what they have to hold in their head. Set out
            in rows the arithmetic is visible: the numbers sum to the total,
            which is the claim the paragraph was making and burying.

            IT ALSO CONTRADICTED ITSELF. The old copy opened "61 of 61 bags use
            the manufacturer's own published figures" and closed by saying 12
            rest on a review measurement — both true by their own definitions
            (bags_maker_sourced asks whether ANY field came from the maker, not
            the dimension) and mutually exclusive on a plain reading. Counted
            in rungs over the published catalogue, that cannot happen.

            And the sentence between them, which Frank called too vague and
            oddly worded: "publish a size without saying which one it is, so we
            show them and say so." It never named the two candidates, so "which
            one" pointed at nothing, and then "show them and say so" put two
            more empty pronouns in a row. Each row now says the thing.

            Echoes /methodology's own source table on purpose: the homepage
            summary and the full explanation should look like the same
            argument, not two different ones. */}
        <p class="mt-2 max-w-3xl text-[0.9375rem] text-ink-2">
          Every one of the {bags.length} bags here sits on exactly one source.
          Only the first can be put forward as an answer.
        </p>

        <div class="mt-3 overflow-x-auto">
          <table class="w-full max-w-2xl text-left text-[0.9375rem]">
            <thead class="text-[0.8125rem] text-muted">
              <tr>
                <th class="py-2 pr-3 font-medium">Where the size came from</th>
                <th class="py-2 pr-3 text-right font-medium">Bags</th>
                <th class="py-2 text-right font-medium">Recommended</th>
              </tr>
            </thead>
            <tbody class="align-top">
              <tr class="border-t border-amber/25">
                <td class="py-2 pr-3">
                  The manufacturer's own outside figure
                  <span class="block text-[0.8125rem] text-muted">wheels and handle included</span>
                </td>
                <td class="py-2 pr-3 text-right font-mono tabular-nums">{onOverall}</td>
                <td class="py-2 text-right font-semibold">Yes</td>
              </tr>
              {onUnlabelled > 0 && (
                <tr class="border-t border-amber/25">
                  <td class="py-2 pr-3">
                    One manufacturer figure, unlabelled
                    <span class="block text-[0.8125rem] text-muted">outside or space inside — they do not say, so we cannot tell whether wheels are counted</span>
                  </td>
                  <td class="py-2 pr-3 text-right font-mono tabular-nums">{onUnlabelled}</td>
                  <td class="py-2 text-right text-muted">No</td>
                </tr>
              )}
              {onReview > 0 && (
                <tr class="border-t border-amber/25">
                  <td class="py-2 pr-3">
                    A review publication measured it
                    <span class="block text-[0.8125rem] text-muted">attributed on the bag's own card</span>
                  </td>
                  <td class="py-2 pr-3 text-right font-mono tabular-nums">{onReview}</td>
                  <td class="py-2 text-right text-muted">No</td>
                </tr>
              )}
              {/* No reseller row. A zero in a table of counts reads as a
                  category we tried and came up empty on, which is the opposite
                  of the truth — marketplace listings are refused by rule, not
                  missing by accident. The line below states it as the policy
                  it is, and keeps every number in the table a real count that
                  sums to the catalogue. */}
            </tbody>
          </table>
        </div>

        <p class="mt-3 max-w-3xl text-[0.9375rem] text-ink-2">
          We never take a size from a reseller or marketplace listing.
          {stats.carriers_researched < stats.carriers_total && (
            <> Of {stats.carriers_total} airlines, {stats.carriers_researched} have
            had their published allowances read from source.</>
          )}
        </p>
        <p class="mt-4 text-[0.9375rem]">        
          <a href="/methodology/" class="text-blue hover:text-blue-hover hover:underline underline-offset-2">Our methodology →</a>
        </p>
      </section>
    )}

  </div>
</Base>
