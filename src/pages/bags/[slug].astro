---
import BagSilhouette from '../../components/BagSilhouette.astro';
import BagVisualizer from '../../components/bag-visualizer/BagVisualizer.astro';
import { isVisualizerEligible } from '../../components/bag-visualizer/eligible.mjs';
import { bagTypeFromRecord, toBagDimensions } from '../../components/bag-visualizer/visualProfile';
import Base from '../../layouts/Base.astro';
import { coverage, evaluate } from '../../engine/fit.mjs';
import { DIM_SOURCE, isPromotable, toCarrier } from '../../engine/normalize.mjs';
import { loadBags, loadCarriers } from '../../lib/data.mjs';
import { loadCarrierSources } from '../../lib/sources.mjs';
import { fareLabel } from '../../ui/fare.mjs';
import {
  SCALE_MAX,
  enforcementLabel,
  enforcementScore,
  isResearched,
  strictnessIcon,
} from '../../ui/strictness.mjs';
import { resultLabel } from '../../ui/verdict.mjs';

/* The bag page, from mockup/bag.html.

   Until now BagCard linked NOWHERE — every card on the landing page and /bags
   was a dead end, which also meant the site had no page for the query people
   actually type: "does the <bag> fit <airline>".

   Three blocks of the mockup are gone, because each assumed something that is
   no longer true:

   - THE MEASUREMENT PHOTOGRAPH. "Taken 24 August 2026 by Frank. This is the
     evidence for the number above." We do not measure bags (docs/19). The
     provenance block says where the figure actually came from instead, which
     is a weaker claim honestly made rather than a strong one invented.
   - THE PRICE AND THE BUY BOX. "$185 at Osprey", with an affiliate link. We
     hold no prices and have no affiliate programme. A price is the easiest
     thing on a page to get wrong and the fastest way to lose a reader.
   - "Every row links to the source on the airline's site." Only true for the
     carriers whose page someone has read; the rest now say so per row. */

export async function getStaticPaths() {
  const bags = await loadBags();
  return bags.map((bag) => ({ params: { slug: bag.slug }, props: { bag } }));
}

const { bag } = Astro.props;
const record = bag.record;

const carriers = await loadCarriers();
const carrierSources = await loadCarrierSources();
const sourceOf = new Map(carrierSources.map((c) => [c.iata, c]));

const cov = coverage(bag, carriers);

/* THE RELEASE GATE, ASKED ONCE.
 *
 * `bag` is an ENGINE bag from toBag(), and toBag() does not carry a
 * `promotable` field — it is a question you ask, not a property you read. Two
 * places on this page read `bag.promotable` anyway. Both got `undefined`, so
 * `!bag.promotable` was permanently true and the amber "Shown, not
 * recommended" notice rendered on ALL 57 bag pages, including the 37 whose
 * figures are the manufacturer's own.
 *
 * That is the worst direction for this particular error. The notice is a
 * confession about sourcing, and printing it under a correctly sourced bag
 * tells the reader our best evidence is untrustworthy — on a site whose entire
 * claim is that we are careful about exactly this.
 *
 * The identical bug was already found and fixed nine lines below, in `better`,
 * with a comment explaining it. It was fixed at ONE of its three call sites.
 * Hence one binding here rather than three reads: the gate is asked once and
 * the answer is passed around.
 */
const promotable = isPromotable(bag);

/* Every airline, grouped the way a traveller thinks about a trip rather than
   the way the dataset is keyed. */
const REGIONS = [
  ['NA', 'North America'],
  ['EU', 'Europe'],
  ['AS', 'Asia'],
  ['ME', 'Middle East'],
];
/* THE CHEAPEST FARE THE AIRLINE ACTUALLY SELLS — not "economy".

   loadCarriers() defaults to { class: 'economy' }, and Ryanair, easyJet, Wizz
   Air, Vueling and Frontier publish no fare called that. Their cabin rows are
   `basic` (plus paid add-ons). So the lookup resolved to nothing, the engine
   correctly refused to answer, and this table labelled five researched, fully
   operating airlines as unanswerable.

   Add-on rows are excluded deliberately: Ryanair Priority is something you
   buy, and defaulting to it would answer a more generous question than the
   reader asked. Same rule as resolveFare — an add-on is opt-in. */
const ADDONS = new Set(['priority', 'carry_on', 'two_pieces']);
const defaultFare = (record) => {
  const cabin = (record.allowances ?? []).filter(
    (a) => a.type === 'cabin' && a.fare_class && !ADDONS.has(a.fare_class)
  );
  return (
    cabin.find((a) => a.fare_class === 'basic')?.fare_class ??
    cabin.find((a) => a.fare_class === 'economy')?.fare_class ??
    cabin[0]?.fare_class ??
    'economy'
  );
};

const rows = carriers
  .map((c) => {
    const carrier = toCarrier(c.record, defaultFare(c.record));
    return { carrier, record: c.record, result: evaluate(bag, carrier) };
  })
  .sort((a, b) => a.carrier.name.localeCompare(b.carrier.name));
const byRegion = REGIONS.map(([code, label]) => ({
  code,
  label,
  rows: rows.filter((r) => r.record?.region === code),
})).filter((g) => g.rows.length);

/* Other sizes of the same product line — the comparison docs/05 asks for:
   same bags, same carrier table, one clears and one doesn't. */
const siblings = record.line
  ? (await loadBags())
      .filter((b) => b.record.line === record.line && b.slug !== bag.slug)
      .map((b) => ({ bag: b, cov: coverage(b, carriers) }))
  : [];

/* Bags that clear more airlines than this one. Only PROMOTABLE bags may be put
   forward as an answer — docs/19's release gate. */
const better = (await loadBags())
  /* isPromotable(), not `b.promotable` — toBag() does not carry that field, so
     the property read was always undefined and this list was silently empty.
     A recommendation section that renders nothing looks like "no better bag
     exists", which is a different and much worse claim. */
  .filter((b) => b.slug !== bag.slug && isPromotable(b))
  .map((b) => ({ bag: b, cov: coverage(b, carriers) }))
  .filter((x) => x.cov.pass > cov.pass)
  .sort((a, b) => b.cov.pass - a.cov.pass)
  .slice(0, 3);

/* THE RUNG IN A HANDFUL OF WORDS.
 *
 * The long sentence folds away, so this is what a reader sees at a glance, and
 * it has to carry the QUALIFICATION rather than just the provenance. A review
 * figure and the manufacturer's own are different claims about how far the
 * number beside them can be trusted, and a reader who never opens the panel
 * must still get that difference.
 *
 * TWO THINGS WERE WRONG WITH THE OLD LABELS, and Frank found both.
 *
 * 1. "What does 'Maker's overall figure' mean?"
 *
 *    It meant nothing unless you already knew the trade's vocabulary. "Overall"
 *    is a term of art for the outside of the bag with wheels and handle
 *    counted, as against the packing body — and knowing that distinction exists
 *    is the ENTIRE premise of this site. Which is exactly why the badge cannot
 *    assume it: the reader who most needs this label is the one who has never
 *    heard of the distinction. The lower rungs never had the problem, because
 *    each names its contrast — "not the maker", "not the outside". The top rung
 *    named neither party nor measurement and leaned on one adjective.
 *
 * 2. "Maker might be unexpected language in the US market — people are more
 *    familiar with manufacturer."
 *
 *    And the site had already decided: /methodology, /sources, /guide and the
 *    folded prose two lines below all say "manufacturer". /bags managed both in
 *    one paragraph — "each manufacturer's own product page", then "where a
 *    maker publishes both". "Maker" reads British, or artisanal, and neither is
 *    what a reader wants from the party whose number decides their verdict.
 *
 * So every rung now answers the two questions actually being asked — WHO said
 * this, and DOES IT INCLUDE THE WHEELS — in the word the rest of the site uses.
 * That is what makes the ladder read as a ladder rather than six labels. */
const SOURCE_BADGE = {
  [DIM_SOURCE.MEASURED]: 'We measured it, wheels and handle included',
  [DIM_SOURCE.MAKER_OVERALL]: "Manufacturer's figure, wheels and handle included",
  [DIM_SOURCE.REVIEW]: 'Review figure, not the manufacturer',
  [DIM_SOURCE.MAKER_UNSPECIFIED]: "Manufacturer's figure, wheels not stated",
  [DIM_SOURCE.MAKER_PACKING]: 'Packing size, not the outside of the bag',
  [DIM_SOURCE.RESELLER]: 'Retail listing, not the manufacturer',
};

/** Anything below maker_overall qualifies the number rather than backing it. */
const SOURCE_IS_WEAK = (rung) =>
  rung !== DIM_SOURCE.MEASURED && rung !== DIM_SOURCE.MAKER_OVERALL;

const SOURCE_LINE = {
  [DIM_SOURCE.MEASURED]: 'We measured this one ourselves.',
  [DIM_SOURCE.MAKER_OVERALL]:
    "This is the manufacturer's own figure for the outside of the bag — wheels and handle included, which is what an airline measures.",
  [DIM_SOURCE.REVIEW]:
    'This figure comes from a review publication, not the manufacturer. We attribute it and are replacing it at source; until then this bag is shown rather than recommended.',
  [DIM_SOURCE.MAKER_UNSPECIFIED]:
    'The manufacturer publishes one figure without saying whether it includes wheels and handle. It is probably the packing body, which runs small — so this bag is shown rather than recommended.',
  [DIM_SOURCE.MAKER_PACKING]:
    'This is explicitly the packing size, which is never what an airline measures.',
  [DIM_SOURCE.RESELLER]: 'A retail listing. We never decide a verdict on one.',
};

/* Where to send a reader to check the number themselves.

   A maker-sourced record carries the product URL in `ref`. A review-sourced
   one carries the source ID, and the URL sits on the matching review — so
   without this, 32 of 39 pages had no link at all and the provenance block
   asserted a source it would not show. */
const refRaw = record.external_cm?.ref ?? null;
const ref = refRaw?.startsWith('http')
  ? refRaw
  : ((record.reviews ?? []).find((r) => r.src === refRaw)?.url ?? null);
const at = record.external_cm?.at ?? null;

/* Name the destination, do not call it "the page".

   Link text has to make sense read on its own: a screen-reader user tabbing
   through links hears only the text, and "their page" or "the page we read"
   tells them nothing about where they are being sent. Same reason /sources
   says "baggage policy" — which is now what the carrier rows say too, since
   four phrasings for one kind of link was three too many. */
const sourceReview = (record.reviews ?? []).find((r) => r.src === refRaw);
const sourceLinkText =
  record.external_cm?.src === 'manufacturer'
    ? `${bag.brand}'s product page`
    : sourceReview?.publication
      ? `${sourceReview.publication}'s review`
      : 'the page this came from';
const gap = record.wheel_handle_delta_cm ?? null;
/* Anything below the maker's own overall figure qualifies the number rather
   than backing it, and the badge says so in amber — the same colour the
   "shown, not recommended" note uses, because it is the same finding. */
const weakSource = SOURCE_IS_WEAK(bag.dim_source);
const dims = (cm) => cm.map((v) => v.toFixed(1).replace(/\.0$/, '')).join(' × ');
const pct = cov.of ? Math.round((cov.pass / cov.of) * 100) : 0;
const tone = pct >= 80 ? 'green' : pct >= 40 ? 'amber' : 'red';
const showVisualizer = isVisualizerEligible(bag);
const packingCm = record.claimed_packing_cm?.v ?? null;
const vizAirlines = rows.map((r) => {
  const fares = [
    ...new Set(
      (r.record.allowances ?? [])
        .filter((a) => a.type === 'cabin' && a.fare_class && !ADDONS.has(a.fare_class))
        .map((a) => a.fare_class)
    ),
  ];
  const fare = defaultFare(r.record);
  return {
    iata: r.record.iata,
    name: r.carrier.name,
    defaultFare: fare,
    fares: fares.length ? fares : [fare],
  };
});
const bagForFit = {
  external_cm: bag.external_cm,
  soft: bag.soft,
  dim_source: bag.dim_source,
  expands_cm: bag.expands_cm,
};
const vizProps = showVisualizer
  ? {
      slug: bag.slug,
      name: `${bag.brand} ${bag.model}`,
      dimensions: toBagDimensions(bag.external_cm),
      packingDimensions: packingCm ? toBagDimensions(packingCm) : undefined,
      dimensionSource: bag.dim_source,
      type: bagTypeFromRecord(record.type),
      wheels: (record.wheels ?? 0) as 0 | 2 | 4,
      soft: Boolean(bag.soft),
      expandsCm: bag.expands_cm > 0 ? bag.expands_cm : undefined,
      wheelHandleDeltaCm: gap ?? null,
      airlines: vizAirlines,
      bagForFit,
      coverage: cov,
      promotable,
      tone,
      pct,
    }
  : null;
const TAG = {
  clears: 'bg-green-wash text-green',
  line: 'bg-lime-wash text-lime',
  likely: 'bg-amber-wash text-amber',
  gamble: 'bg-orange-wash text-orange',
  wont: 'bg-red-wash text-red',
};
const BAR = { green: 'bg-green', amber: 'bg-amber', red: 'bg-red' };
const INK = { green: 'text-green', amber: 'text-amber', red: 'text-red' };
---
<Base
  title={`${bag.brand} ${bag.model} — does it fit? — Sizer`}
  description={`${bag.brand} ${bag.model} measures ${dims(bag.external_cm)} cm on the outside and clears ${cov.pass} of ${cov.of} airlines we can answer for.`}
>
  <div class="mx-auto max-w-page px-6 pt-6">

    <p class="text-[0.9375rem] text-muted">
      <a href="/bags/" class="text-blue hover:text-blue-hover hover:underline underline-offset-2">Bags</a> › {bag.brand}
    </p>

    <header class="pt-2 pb-5">
      <p class="text-[0.9375rem] text-muted">{record.type}</p>
      <h1 class="mt-1 max-w-[42ch] text-3xl font-bold tracking-tight sm:text-4xl lg:max-w-none lg:text-[2.35rem] lg:leading-tight">
        {bag.brand} {bag.model}
      </h1>
    </header>

    <div class="flex flex-col gap-4 pb-10 lg:grid lg:items-start lg:gap-x-8 lg:gap-y-4 lg:grid-cols-[minmax(0,1fr)_minmax(28rem,36rem)]">
      {/* Rows, not one tall left block. The airline picker and the size
          comparison used to live inside the visualiser's card in the right
          column, stacked UNDER the 3D stage — where they were, in Frank's
          words, lost below the dataviz. They are the part a reader acts on, so
          they now sit in the left column beneath "Where this number comes
          from", and the stage keeps the wide column to itself. */}
      <div class="order-1 flex flex-col gap-4 lg:col-start-1 lg:row-start-1">
        {/* THE FIGURE NEVER WRAPS. A dimension triple broken across two lines
            reads as two numbers, and this is the number the whole page exists
            to state. So the value is nowrap and unshrinkable; the LABEL is what
            gives way when the column is narrow. "as an airline measures it" was
            also carrying the argument that belongs to the block below it —
            shortened, since "Outside" is the distinction and the source note
            explains why it matters. */}
        <dl class="overflow-hidden rounded-card border border-rule bg-surface">
          <div class="flex items-baseline justify-between gap-3 border-b border-rule px-5 py-3.5">
            <dt class="min-w-0 text-[0.9375rem] text-muted">Outside, with wheels</dt>
            <dd class="shrink-0 whitespace-nowrap font-mono text-lg font-semibold tabular-nums" data-dims={JSON.stringify(bag.external_cm)}>{dims(bag.external_cm)} cm</dd>
          </div>
          {record.claimed_packing_cm && (
            <div class="flex items-baseline justify-between gap-3 border-b border-rule px-5 py-3.5">
              <dt class="min-w-0 text-[0.9375rem] text-muted">Packing space inside</dt>
              <dd class="shrink-0 whitespace-nowrap font-mono text-[0.9375rem] tabular-nums text-muted" data-dims={JSON.stringify(record.claimed_packing_cm.v)}>{dims(record.claimed_packing_cm.v)} cm</dd>
            </div>
          )}
          {bag.weight_kg && (
            <div class="flex items-baseline justify-between gap-3 border-b border-rule px-5 py-3.5">
              <dt class="min-w-0 text-[0.9375rem] text-muted">Weight, empty</dt>
              <dd class="shrink-0 whitespace-nowrap font-mono text-[0.9375rem] tabular-nums" data-kg={bag.weight_kg}>{bag.weight_kg} kg</dd>
            </div>
          )}
          {bag.expands_cm > 0 && (
            <div class="flex items-baseline justify-between gap-3 px-5 py-3.5">
              <dt class="min-w-0 text-[0.9375rem] text-muted">Expander adds</dt>
              <dd class="shrink-0 whitespace-nowrap font-mono text-[0.9375rem] tabular-nums text-amber">+{bag.expands_cm} cm</dd>
            </div>
          )}
        </dl>

        {/* The mockup put a photograph of a tape measure here. We do not
            measure bags, so this says where the number came from instead. */}
        <div class="rounded-card border border-rule bg-surface-2 p-5">
          {/* ONE LINE OPEN, THE REST FOLDED.
              This card had grown to five stacked paragraphs and was pushing the
              airline picker — the thing a reader actually came to use — down
              the page. Frank: "we really want to reduce the vertical space."

              WHAT STAYS VISIBLE IS A JUDGEMENT, NOT A LENGTH BUDGET. Earlier I
              argued the source sentence and the link must never fold, on the
              grounds that collapsing an explanation is editing and collapsing a
              citation is hiding. That still holds — so the collapse keeps the
              part that QUALIFIES the number:

                Review figure, not the manufacturer  ·  Travel + Leisure ↗

              Two or three words and a link. A reader who never opens the panel
              still learns that the figure above is not the manufacturer's, and
              can still click through to check it. The prose that explains WHY
              that matters is the part that folds, because it is an explanation.

              "This number" was also wrong: the panel covers dimensions AND
              weight, and for many bags several figures with different sources.
              "These figures" is what it has always described. */}
          <div class="flex flex-wrap items-baseline gap-x-2 gap-y-1">
            <span class={`text-[0.875rem] font-semibold ${weakSource ? 'text-amber' : 'text-ink'}`}>
              {SOURCE_BADGE[bag.dim_source] ?? 'Source not recorded'}
            </span>
            {ref && (
              <a
                href={ref}
                rel="nofollow noopener noreferrer"
                target="_blank"
                class="text-[0.875rem] text-blue hover:text-blue-hover hover:underline underline-offset-2"
              >{sourceLinkText} ↗</a>
            )}
            {at && <span class="text-[0.8125rem] text-muted">· read {at}</span>}
          </div>

          <details class="group mt-1.5">
              <summary
                class="inline-flex cursor-pointer list-none items-center gap-1 text-[0.875rem] font-semibold text-blue hover:text-blue-hover hover:underline underline-offset-2 [&::-webkit-details-marker]:hidden"
              >
                <span class="group-open:hidden">Where these figures come from</span>
                <span class="hidden group-open:inline">Show less</span>
                <span aria-hidden="true" class="transition-transform group-open:rotate-180">▾</span>
              </summary>

              <p class="mt-2 text-[0.9375rem] text-ink-2">
                {SOURCE_LINE[bag.dim_source] ?? 'Source not recorded.'}
              </p>

              {gap && (
                <p class="mt-2 text-[0.875rem] text-muted">
                  Wheels, handle and feet add{' '}
                  <strong class="text-ink">
                    {gap.filter((v) => v > 0).map((v, i) => (
                      <Fragment>{i > 0 && ', '}<span data-cm={v}>{v} cm</span></Fragment>
                    ))}
                  </strong>{' '}
                  over the packing figure.
                </p>
              )}
              {gap && (
                <p class="mt-2 text-[0.875rem] text-muted">
                  That difference is the whole reason a bag sold as carry-on size
                  gets stopped: the brochure figure measures the packing space,
                  and the gate measures the outside.
                </p>
              )}
              {(record.conflicts ?? []).length > 0 && (
                <ul class="mt-3 space-y-2 border-t border-rule pt-3">
                  {record.conflicts.map((c) => (
                    <li class="text-[0.875rem] text-muted">{c.detail}</li>
                  ))}
                </ul>
              )}
          </details>
        </div>
      </div>

      {showVisualizer && vizProps ? (
        <BagVisualizer {...vizProps} />
      ) : (
        <aside class="order-2 rounded-card border border-rule bg-surface p-5 shadow-panel lg:col-start-2 lg:row-start-1 lg:sticky lg:top-6 lg:self-start">
          <div class={`grid place-items-center rounded-chip bg-surface-2 py-6 ${INK[tone]}`} aria-hidden="true">
            <BagSilhouette type={record.type} class="h-28 w-auto" />
          </div>
          <p class="mt-4 text-[2.25rem] font-bold leading-none tracking-tight tabular-nums">
            {cov.pass}<span class="text-muted">/{cov.of}</span>
          </p>
          <p class="mt-1 text-[0.9375rem] text-ink-2">airlines it gets past</p>
          <span class="mt-3 block h-2 overflow-hidden rounded-full bg-surface-2">
            <span class={`block h-full rounded-full ${BAR[tone]}`} style={`width:${pct}%`}></span>
          </span>
          {cov.unknown > 0 && (
            <p class="mt-2 text-[0.8125rem] text-muted">
              {cov.unknown} more we cannot answer for yet, and they are left out of
              that fraction rather than counted as passes.
            </p>
          )}
          {!promotable && (
            <p class="mt-3 rounded-chip bg-amber-wash p-3 text-[0.8125rem] text-amber">
              Shown, not recommended — the dimension above is not the
              manufacturer's own figure for the outside of the bag.
            </p>
          )}
          <a
            href="/check/"
            class="mt-4 block rounded-chip bg-blue px-4 py-3 text-center font-semibold text-on-blue no-underline hover:bg-blue-hover"
          >Check it against your trip</a>
        </aside>
      )}

    </div>

    <section class="border-t border-rule py-10">
      <h2 class="text-2xl font-semibold tracking-tight">Every airline we track</h2>
      <p class="mt-2 max-w-[64ch] text-ink-2">
        On the cheapest economy fare each airline publishes. A different fare
        often changes the answer, which is what{' '}
        <a href="/check/" class="text-blue hover:text-blue-hover hover:underline underline-offset-2">the trip checker</a> is for.
      </p>

      {byRegion.map((group) => (
        <div class="mt-7">
          <h3 class="text-lg font-semibold">{group.label}</h3>
          <div class="mt-2 overflow-hidden rounded-card border border-rule">
            {group.rows.map(({ carrier, record: cRecord, result }) => (
              <div class="grid grid-cols-[minmax(0,1fr)_9rem_8.5rem] items-center gap-3 border-b border-rule px-4 py-3 text-[0.9375rem] last:border-b-0">
                <span>
                  <span class="font-semibold">{carrier.name}</span>
                  <span class="flex flex-wrap items-center gap-x-1 text-[0.8125rem] text-muted">
                    {fareLabel(carrier.fare_class)}
                    {enforcementScore(cRecord.strictness?.score) !== null && (
                      <>
                        {' · '}
                        <Fragment set:html={strictnessIcon(cRecord.strictness?.score, { size: 13 })} />
                        {' '}
                        <span class="font-mono">{enforcementScore(cRecord.strictness?.score)}/{SCALE_MAX}</span>
                        {' '}
                        {enforcementLabel(cRecord.strictness?.score).toLowerCase()}
                        {!isResearched(cRecord.strictness) &&
                          !(cRecord.strictness?.evidence ?? []).some((e) => e.claim) &&
                          ' (assumed)'}
                      </>
                    )}
                    {sourceOf.has(carrier.iata) ? (
                      <>
                        {' · '}
                        <a href={sourceOf.get(carrier.iata).url} rel="nofollow noopener noreferrer" target="_blank" class="text-blue hover:text-blue-hover hover:underline underline-offset-2">baggage policy ↗</a>
                      </>
                    ) : (
                      <span> · no source recorded yet</span>
                    )}
                  </span>
                </span>
                <span class="font-mono text-[0.8125rem] text-ink-2">
                  {result.band === null
                    ? 'not researched'
                    : result.no_cabin_bag
                      ? 'no cabin bag'
                      : result.delta_cm > 0
                        ? `${result.delta_cm} cm too ${result.dimension}`
                        : `${Math.abs(result.delta_cm)} cm to spare`}
                </span>
                {/* whitespace-nowrap so a label can never wrap inside its
                    pill, whatever wording we settle on. The column is sized
                    for the longest one rather than the shortest. */}
                <span class={`rounded-full px-2.5 py-1 text-center text-[0.875rem] font-semibold whitespace-nowrap ${
                  result.band ? TAG[result.band] : 'bg-surface-2 text-muted'
                }`}>{resultLabel(result)}</span>
              </div>
            ))}
          </div>
        </div>
      ))}
    </section>

    {siblings.length > 0 && (
      <section class="border-t border-rule py-10">
        <h2 class="text-2xl font-semibold tracking-tight">The other sizes in this line</h2>
        <p class="mt-2 max-w-[64ch] text-ink-2">
          Same bag, same manufacturer, different dimensions — and often a different
          answer. This is the comparison a product page never shows you.
        </p>
        <div class="mt-5 grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
          {siblings.map(({ bag: sib, cov: c }) => (
            <a href={`/bags/${sib.slug}/`} class="block rounded-card border border-rule bg-surface p-4 no-underline hover:border-blue">
              <span class="block font-semibold text-ink">{sib.model}</span>
              <span class="mt-1 block font-mono text-[0.84375rem] text-muted" data-dims={JSON.stringify(sib.external_cm)}>{dims(sib.external_cm)} cm</span>
              <span class="mt-2 block text-[0.9375rem] text-ink-2">Clears {c.pass} of {c.of}</span>
            </a>
          ))}
        </div>
      </section>
    )}

    {/* Straight from the mockup, and the most honest section on the site. */}
    <section class="border-t border-rule py-10">
      <h2 class="text-2xl font-semibold tracking-tight">What we don't tell you</h2>
      <p class="mt-2 max-w-[64ch] text-ink-2">
        We check whether a bag fits. We don't review — and those are genuinely
        different jobs.
      </p>
      <p class="mt-4 max-w-[64ch] text-ink-2">
        Whether a bag survives five years, whether the wheels cope with
        cobblestones, whether the warranty gets honoured, whether the handle
        rattles — none of that shows up in a dimension. We have nothing useful
        to say about any of it.
      </p>
      {(record.reviews ?? []).length > 0 && (
        <div class="mt-5 rounded-card border border-rule bg-surface p-5">
          <p class="text-[0.8125rem] font-semibold text-muted">Rated elsewhere</p>
          <ul class="mt-2 space-y-3">
            {record.reviews.map((r) => (
              <li class="text-ink-2">
                <a href={r.url} rel="nofollow noopener noreferrer" target="_blank" class="font-semibold text-blue hover:text-blue-hover hover:underline underline-offset-2">{r.publication}</a>
                {r.award && <span> — {r.award}</span>}
                {r.caveat && <span class="block text-[0.9375rem] text-muted">“{r.caveat}”</span>}
              </li>
            ))}
          </ul>
          <p class="mt-4 max-w-[62ch] text-[0.9375rem] text-ink-2">
            <strong class="text-ink">Both of those are true.</strong> They are
            answering whether this is a good bag. We are answering whether it
            gets on the plane. Be wary of anyone claiming to settle both at once.
          </p>
        </div>
      )}
    </section>

    {better.length > 0 && (
      <section class="border-t border-rule py-10">
        <h2 class="text-2xl font-semibold tracking-tight">Bags that get past more airlines</h2>
        <p class="mt-2 max-w-[64ch] text-ink-2">
          Only bags carrying the manufacturer's own overall figure appear here —
          we will not put a bag forward as an answer on someone else's tape
          measure.
        </p>
        <div class="mt-5 grid gap-4 sm:grid-cols-3">
          {better.map(({ bag: alt, cov: c }) => (
            <a href={`/bags/${alt.slug}/`} class="block rounded-card border border-rule bg-surface p-4 no-underline hover:border-blue">
              <span class="block text-[0.8125rem] text-muted">{alt.brand}</span>
              <span class="block font-semibold text-ink">{alt.model}</span>
              <span class="mt-1 block font-mono text-[0.84375rem] text-muted" data-dims={JSON.stringify(alt.external_cm)}>{dims(alt.external_cm)} cm</span>
              <span class="mt-2 block text-[0.9375rem] text-ink-2">Clears {c.pass} of {c.of}</span>
            </a>
          ))}
        </div>
      </section>
    )}

    <div class="mb-16 flex flex-wrap items-center justify-between gap-5 rounded-card bg-blue-wash p-6">
      <p class="max-w-[46ch] text-lg text-ink-2">
        <strong class="font-semibold text-ink">Flying somewhere specific?</strong>{' '}
        Check this bag against your actual airlines and the fare you booked — the
        answer changes a lot by fare.
      </p>
      <a
        href="/check/"
        class="rounded-chip bg-blue px-5 py-3 font-semibold text-on-blue no-underline hover:bg-blue-hover"
      >Check my trip →</a>
    </div>

  </div>
</Base>
