---
import Base from '../../layouts/Base.astro';
import BagCard from '../../components/BagCard.astro';
import BagFilters, { GROUPS } from '../../components/BagFilters.astro';
import {
  ROLE_FACETS,
  SHELL_FACETS,
  WEIGHT_FACETS,
  brandFacets,
  facetsFor,
  optionCount,
} from '../../lib/bag-facets.mjs';
import { BAND_IDS } from '../../lib/price-band.mjs';
import { loadBags, loadCarriers, coverageStats } from '../../lib/data.mjs';
import { shelve } from '../../lib/shelves.mjs';

const bags = await loadBags();
const carriers = await loadCarriers();
const shelves = shelve(bags, carriers);
const stats = await coverageStats();
const answerable = carriers.filter((c) => !c.cabin_unknown).length;

/* Counts per filter group, so a pill with nothing behind it never renders — a
   dead filter is a dead end the reader has to discover by clicking it. */
const counts = Object.fromEntries(
  GROUPS.map((g) => [g.id, bags.filter((b) => g.types.includes(b.record.type)).length])
);

/* Facet values, computed once and stamped onto each card.
   Every shelf entry, not just the ones a shelf happens to show — the counts in
   the panel have to describe the page, and a bag can sit on more than one
   shelf. */
const entries = shelves.flatMap((s) => s.bags);
const facets = facetsFor(entries);

/* Counted per OPTION, not per stamped value, because the weight options are
   cumulative — "under 3.5 kg" has to include every bag under 2.5 kg too.
   Counting the raw buckets would print a number beside a checkbox that is not
   the number of cards ticking it leaves on screen. */
/* Brands are DERIVED from the catalogue, not listed. A typed list goes stale
   the first time a bag is added, and silently — a brand nobody declared simply
   never appears in the panel, which reads as "they do not stock it". */
const brands = brandFacets(entries);
const AXES = {
  weight: WEIGHT_FACETS.map((f) => f.id),
  shell: SHELL_FACETS.map((f) => f.id),
  price: BAND_IDS,
  role: ROLE_FACETS.map((f) => f.id),
  brand: brands.map((b) => b.id),
};
const optionCounts = Object.fromEntries(
  Object.entries(AXES).map(([axis, ids]) => [
    axis,
    Object.fromEntries(ids.map((id) => [id, optionCount(facets, axis, id)])),
  ])
);
const bagTotal = new Set(entries.map((e) => e.bag.slug)).size;

/* "Last updated" has to mean something: the most recent day anyone read a
   source, not the day the site was rebuilt. */
const dates = bags
  .map((b) => b.record.measured_at ?? b.record.external_cm?.at)
  .filter(Boolean)
  .sort();
const lastUpdated = dates.length
  ? new Date(dates.at(-1)).toLocaleDateString('en-GB', {
      day: 'numeric',
      month: 'short',
      year: 'numeric',
    })
  : null;
---
<Base
  title="Carry-on bags that fit — Sizer"
  description={`Every bag we track, checked on its overall size against ${answerable} airlines.`}
>
  <div class="mx-auto max-w-page px-6">

    <section class="pt-12 pb-6">
      {/* A BIG TITLE HAS TO LAND WITHOUT THE PARAGRAPH UNDER IT.

          It read "Bags checked against the airline's own limit", and Frank was
          right to stop at it. Two things in six words need explaining before it
          means anything: WHICH airline — the reader has named none — and what
          "own" is doing, which is quietly arguing against reseller listings, a
          case they have not heard yet.

          It also described OUR PROCESS rather than what the reader gets. Every
          other headline on the site is the reader's job in plain words: "Check
          your whole trip", "Why bags get stopped at the gate", "How we work it
          out". This was the only one that wasn't, which is why it was the one
          that read as a puzzle.

          The mockup's version was "Bags we've put a tape measure on" — dropped
          long ago because we do not measure bags (docs/19). The replacement
          reached for a defensible claim and landed on an unreadable one. Both
          the claim and the reading matter, and the claim below is just as
          careful: "ranked" describes the ordering, so it stays true of the low
          shelf too, where the bags fit almost nothing.

          It also finishes the sentence the home page starts. That card says
          "Bags ranked by how many airlines they fit"; arriving here on a
          headline that says the same thing is how a reader knows the link did
          what they expected. */}
      <h1 class="max-w-2xl text-4xl font-bold leading-tight tracking-tight sm:text-5xl">
        Carry-on bags, ranked by how many airlines they fit
      </h1>
      {/* The service statement first, the provenance under it. Same order as
          the home page, and for the same reason: someone still deciding whether
          they are in the right place is not yet asking where our numbers came
          from. */}
      <p class="mt-5 max-w-2xl text-lg text-ink-2">
        Each one measured on its outside — wheels and handle included, the way a
        gate measures it — against {answerable} airlines, fare by fare.
      </p>
      <p class="mt-3 max-w-2xl text-ink-2">
        Dimensions come from each manufacturer's own product page, never a
        marketplace listing where the same bag turns up with different numbers
        from different sellers. Where a manufacturer publishes both the packing
        size and the <strong class="text-ink">outside</strong> size we use the
        outside one — and where they publish both, we show you both. The gap
        between them is usually where the trouble starts.
      </p>
      <p class="mt-4 font-mono text-[0.875rem] text-muted">
        {bags.length} bags · checked against {answerable} airlines{lastUpdated && ` · last updated ${lastUpdated}`}
      </p>
    </section>

    <BagFilters counts={counts} optionCounts={optionCounts} total={bagTotal} brands={brands} />

    {shelves.map((shelf) => shelf.bags.length > 0 && (
      <section data-shelf class="border-b border-rule py-10">
        <div class="flex flex-wrap items-baseline justify-between gap-2">
          <h2 class="text-2xl font-semibold tracking-tight">{shelf.title}</h2>
          <span data-shelf-count class="font-mono text-[0.8125rem] text-muted">
            {shelf.bags.length} bags
          </span>
        </div>
        <p class="mt-1 max-w-2xl text-ink-2">{shelf.blurb}</p>

        <div class="mt-6 grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
          {shelf.bags.map(({ bag, coverage }) => (
            <div
              data-bag-slug={bag.slug}
              data-bag-type={bag.record.type}
              data-bag-weight={facets.get(bag.slug)?.weight ?? ''}
              data-bag-shell={facets.get(bag.slug)?.shell ?? ''}
              data-bag-price={facets.get(bag.slug)?.price ?? ''}
              data-bag-role={facets.get(bag.slug)?.role ?? ''}
              data-bag-brand={facets.get(bag.slug)?.brand ?? ''}
            >
              <BagCard bag={bag} coverage={coverage} />
            </div>
          ))}
        </div>
      </section>
    ))}

    {/* Said without naming a cause. The old copy read "matches that shape",
        written when a shape pill was the only way to empty the page — a reader
        who emptied it with a weight filter was told the wrong thing about
        their own catalogue. The button is the point: an empty page with no way
        back out is a dead end. */}
    <p data-empty hidden class="py-10 text-ink-2">
      No bag in the catalogue matches all of those at once.{' '}
      <button type="button" data-clear-all class="cursor-pointer text-blue underline underline-offset-2 hover:text-blue-hover">
        Clear the filters
      </button>
    </p>

    {stats.bags_promotable < stats.bags_sized && (
      <p class="py-8 text-[0.875rem] text-muted">
        {stats.bags_maker_sourced} of these use the manufacturer's own published
        figures; for {stats.bags_promotable} the manufacturer states it is the
        outside of the bag, and only those are recommended.{' '}
        {stats.bags_review_only > 0 && (
          <>{stats.bags_review_only} rest on a review publication's measurement,
          named on the card.{' '}</>
        )}
        <a href="/methodology/" class="text-blue hover:text-blue-hover hover:underline underline-offset-2">How we work it out →</a>
      </p>
    )}

  </div>
</Base>
