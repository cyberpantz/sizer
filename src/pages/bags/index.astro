---
import Base from '../../layouts/Base.astro';
import BagCard from '../../components/BagCard.astro';
import BagFilters, { GROUPS } from '../../components/BagFilters.astro';
import { loadBags, loadCarriers, coverageStats } from '../../lib/data.mjs';
import { shelve } from '../../lib/shelves.mjs';

const bags = await loadBags();
const carriers = await loadCarriers();
const shelves = shelve(bags, carriers);
const stats = await coverageStats();
const answerable = carriers.filter((c) => !c.cabin_unknown).length;

/* Counts per filter group, so a pill with nothing behind it never renders — a
   dead filter is a dead end the reader has to discover by clicking it. */
const counts = Object.fromEntries(
  GROUPS.map((g) => [g.id, bags.filter((b) => g.types.includes(b.record.type)).length])
);

/* "Last updated" has to mean something: the most recent day anyone read a
   source, not the day the site was rebuilt. */
const dates = bags
  .map((b) => b.record.measured_at ?? b.record.external_cm?.at)
  .filter(Boolean)
  .sort();
const lastUpdated = dates.length
  ? new Date(dates.at(-1)).toLocaleDateString('en-GB', { day: 'numeric', month: 'short', year: 'numeric' })
  : null;
---
<Base
  title="Carry-on bags that fit — Sizer"
  description={`Every bag we track, checked on its overall size against ${answerable} airlines.`}
>
  <div class="mx-auto max-w-page px-6">

    <section class="pt-12 pb-6">
      {/* The mockup read "Bags we've put a tape measure on". That is no longer
          true — we are not measuring bags. The claim we can actually make is
          narrower and still worth making. See docs/19. */}
      <h1 class="max-w-2xl text-4xl font-bold leading-tight tracking-tight sm:text-5xl">
        Bags checked against the airline's own limit
      </h1>
      <p class="mt-5 max-w-2xl text-lg text-ink-2">
        Dimensions come from each manufacturer's own product page — never a
        marketplace listing, where the same bag turns up with different numbers
        from different sellers. Where a maker publishes both the packing size and
        the <strong class="text-ink">overall</strong> size, we use the overall
        one, because that is what an airline measures: wheels, handle and all.
      </p>
      <p class="mt-3 max-w-2xl text-ink-2">
        Where they publish both, we show you both — the gap between them is
        usually where the trouble starts.
      </p>
      <p class="mt-4 font-mono text-[0.875rem] text-muted">
        {bags.length} bags · checked against {answerable} airlines{lastUpdated && ` · last updated ${lastUpdated}`}
      </p>
    </section>

    <BagFilters counts={counts} total={bags.length} />

    {shelves.map((shelf) => shelf.bags.length > 0 && (
      <section data-shelf class="border-b border-rule py-10">
        <div class="flex flex-wrap items-baseline justify-between gap-2">
          <h2 class="text-2xl font-semibold tracking-tight">{shelf.title}</h2>
          <span data-shelf-count class="font-mono text-[0.8125rem] text-muted">
            {shelf.bags.length} bags
          </span>
        </div>
        <p class="mt-1 max-w-2xl text-ink-2">{shelf.blurb}</p>

        <div class="mt-6 grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
          {shelf.bags.map(({ bag, coverage }) => (
            <div data-bag-type={bag.record.type}>
              <BagCard bag={bag} coverage={coverage} />
            </div>
          ))}
        </div>
      </section>
    ))}

    <p data-empty hidden class="py-10 text-ink-2">
      Nothing in the catalogue matches that shape yet.
    </p>

    {stats.bags_promotable < stats.bags_sized && (
      <p class="py-8 text-[0.875rem] text-muted">
        {stats.bags_promotable} of these carry the manufacturer's own overall
        dimensions. The rest use a review publication's measurement, named on the
        card, which we are replacing at source.{' '}
        <a href="/methodology/" class="text-blue">How we work it out →</a>
      </p>
    )}

  </div>
</Base>
